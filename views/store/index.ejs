<%- include('../partials/header') %>
</head>
<body class="bg-gradient-to-br from-gray-900 via-gray-800 to-black min-h-screen flex flex-col">
   <%- include('../partials/nav.ejs') %>
    
    <div class="flex-grow pt-20">
        <div class="container mx-auto px-4 py-12">
            <div class="text-center space-y-4 mb-12 hidden lg:block">
                <h1 class="text-4xl font-bold text-white/90">
                    Discover Our Premium Properties
                </h1>
                <p class="text-gray-400 max-w-2xl mx-auto">
                    Explore our handpicked selection of luxury homes and unique stays around the world
                </p>
            </div>

            <%- include('../partials/searchBar') %>

            <div class="text-center space-y-3 mb-8 lg:hidden">
                <h1 class="text-2xl font-bold text-white/90">
                    Premium Properties
                </h1>
                <p class="text-gray-400 text-sm">
                    Find your perfect stay
                </p>
            </div>

            <!-- Premium Homes Category -->
            <div class="mb-16">
                <div class="flex items-center mb-8">
                    <svg class="w-5 h-5 sm:w-6 lg:w-6 text-yellow-400 mr-2 sm:mr-3 lg:mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                    <h2 class="text-lg sm:text-2xl lg:text-3xl font-bold text-white/90">Trending Stays</h2>
                </div>

                <!-- Horizontal Scrollable Container -->
                <div class="relative">
                    <div class="overflow-x-auto scrollbar-hide">
                        <div class="flex gap-2 sm:gap-4 lg:gap-6 pb-2 sm:pb-3 lg:pb-4 w-max px-2 sm:px-3 lg:px-4">
                            <% trendingHomes.forEach((Home)=>{ %>
                                <div class="flex-shrink-0 w-48 sm:w-64 lg:w-80 backdrop-blur-md bg-white/10 border border-white/20 rounded-lg sm:rounded-xl lg:rounded-2xl overflow-hidden shadow-lg sm:shadow-lg lg:shadow-xl transition-all duration-300 hover:scale-[1.02] hover:shadow-2xl group">
                                    <div class="relative aspect-video overflow-hidden">
                                        <img 
                                            src="<%= Home.photoUrl %>" 
                                            alt="<%=Home.houseName%>"
                                            class="object-cover w-full h-full transform group-hover:scale-110 transition-transform duration-700"
                                        >
                                        <div class="absolute top-2 right-2 sm:top-3 sm:right-3 lg:top-4 lg:right-4">
                                            <span class="px-2 py-1 sm:px-3 sm:py-1.5 lg:px-4 lg:py-2 rounded-full text-xs sm:text-sm lg:text-sm backdrop-blur-md bg-black/50 text-white/90 border border-white/10">
                                                ₹<%= Home.price %> per night
                                            </span>
                                        </div>
                                    </div>

                                    <div class="p-3 sm:p-4 lg:p-6 space-y-2 sm:space-y-3 lg:space-y-4">
                                        <div class="space-y-1 sm:space-y-1.5 lg:space-y-2">
                                            <h2 class="text-sm sm:text-base lg:text-xl font-bold text-white/90 line-clamp-1"><%=Home.houseName%></h2>
                                            <span class="flex items-center text-white/70 text-xs sm:text-sm lg:text-sm">
                                                <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5 lg:w-4 lg:h-4 mr-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                                    <path d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"/>
                                                </svg>
                                                <%= Home.location %>
                                            </span>
                                            <p class="text-gray-400 line-clamp-2 text-xs sm:text-sm lg:text-sm">
                                                <%= Home.description %>
                                            </p>
                                        </div>

                                        <div class="grid grid-cols-3 gap-2 sm:gap-2.5 lg:gap-3 py-2 sm:py-2.5 lg:py-3 border-t border-white/10">
                                            <div class="text-center">
                                                <span class="block text-white/90 font-medium text-xs sm:text-sm lg:text-sm"><%= Home.bedrooms %></span>
                                                <span class="text-xs lg:text-xs text-gray-400">Beds</span>
                                            </div>
                                            <div class="text-center">
                                                <span class="block text-white/90 font-medium text-xs sm:text-sm lg:text-sm"><%= Home.bathrooms %></span>
                                                <span class="text-xs lg:text-xs text-gray-400">Baths</span>
                                            </div>
                                            <div class="text-center">
                                                <span class="block text-white/90 font-medium text-xs sm:text-sm lg:text-sm"><%= Home.squareFt %></span>
                                                <span class="text-xs lg:text-xs text-gray-400">Sq. Ft.</span>
                                            </div>
                                        </div>

                                        <div class="flex items-center justify-between pt-1 sm:pt-1.5 lg:pt-2 gap-1 sm:gap-2 lg:gap-0">
                                            <span class="flex items-center text-yellow-400 text-xs sm:text-sm lg:text-sm">
                                                ★★★★★
                                                <span class="ml-1 text-white/70">5.0</span>
                                            </span>
                                            <a href="/booking/<%= Home._id %>" class="px-2 py-1 sm:px-3 sm:py-1.5 lg:px-4 lg:py-2 rounded text-white font-medium text-xs sm:text-sm lg:text-sm backdrop-blur-lg bg-white/20 border border-white/10 shadow-lg transition-all duration-300 hover:scale-105 hover:bg-white/30">
                                                Book
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Budget Friendly Category -->
            <div class="mb-16">
                <div class="flex items-center mb-8">
                    <svg class="w-5 h-5 sm:w-6 lg:w-6 text-green-400 mr-2 sm:mr-3 lg:mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M8.16 2.75a.75.75 0 00-1.08.6v5.69H2.75a.75.75 0 00-.6 1.08l6.5 8.666.072.093a.75.75 0 001.2-.976l-.072-.093L4.31 11h4.84a.75.75 0 00.743-.648L9.99 10.2v-5.69a.75.75 0 00-.75-.75z"/>
                    </svg>
                    <h2 class="text-lg sm:text-2xl lg:text-3xl font-bold text-white/90">Budget Friendly</h2>
                </div>

                <div class="relative">
                    <div class="overflow-x-auto scrollbar-hide">
                        <div class="flex gap-2 sm:gap-4 lg:gap-6 pb-2 sm:pb-3 lg:pb-4 w-max px-2 sm:px-3 lg:px-4">
                            <% cheapHomes.forEach((Home)=>{ %>
                                <div class="flex-shrink-0 w-48 sm:w-64 lg:w-80 backdrop-blur-md bg-white/10 border border-white/20 rounded-lg sm:rounded-xl lg:rounded-2xl overflow-hidden shadow-lg sm:shadow-lg lg:shadow-xl transition-all duration-300 hover:scale-[1.02] hover:shadow-2xl group">
                                    <div class="relative aspect-video overflow-hidden">
                                        <img 
                                            src="<%= Home.photoUrl %>" 
                                            alt="<%=Home.houseName%>"
                                            class="object-cover w-full h-full transform group-hover:scale-110 transition-transform duration-700"
                                        >
                                        <div class="absolute top-2 right-2 sm:top-3 sm:right-3 lg:top-4 lg:right-4">
                                            <span class="px-2 py-1 sm:px-3 sm:py-1.5 lg:px-4 lg:py-2 rounded-full text-xs sm:text-sm lg:text-sm backdrop-blur-md bg-black/50 text-white/90 border border-white/10">
                                                ₹<%= Home.price %> per night
                                            </span>
                                        </div>
                                    </div>

                                    <div class="p-3 sm:p-4 lg:p-6 space-y-2 sm:space-y-3 lg:space-y-4">
                                        <div class="space-y-1 sm:space-y-1.5 lg:space-y-2">
                                            <h2 class="text-sm sm:text-base lg:text-xl font-bold text-white/90 line-clamp-1"><%=Home.houseName%></h2>
                                            <span class="flex items-center text-white/70 text-xs sm:text-sm lg:text-sm">
                                                <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5 lg:w-4 lg:h-4 mr-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                                    <path d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"/>
                                                </svg>
                                                <%= Home.location %>
                                            </span>
                                            <p class="text-gray-400 line-clamp-2 text-xs sm:text-sm lg:text-sm">
                                                <%= Home.description %>
                                            </p>
                                        </div>

                                        <div class="grid grid-cols-3 gap-2 sm:gap-2.5 lg:gap-3 py-2 sm:py-2.5 lg:py-3 border-t border-white/10">
                                            <div class="text-center">
                                                <span class="block text-white/90 font-medium text-xs sm:text-sm lg:text-sm"><%= Home.bedrooms %></span>
                                                <span class="text-xs lg:text-xs text-gray-400">Beds</span>
                                            </div>
                                            <div class="text-center">
                                                <span class="block text-white/90 font-medium text-xs sm:text-sm lg:text-sm"><%= Home.bathrooms %></span>
                                                <span class="text-xs lg:text-xs text-gray-400">Baths</span>
                                            </div>
                                            <div class="text-center">
                                                <span class="block text-white/90 font-medium text-xs sm:text-sm lg:text-sm"><%= Home.squareFt %></span>
                                                <span class="text-xs lg:text-xs text-gray-400">Sq. Ft.</span>
                                            </div>
                                        </div>

                                        <div class="flex items-center justify-between pt-1 sm:pt-1.5 lg:pt-2 gap-1 sm:gap-2 lg:gap-0">
                                            <span class="flex items-center text-yellow-400 text-xs sm:text-sm lg:text-sm">
                                                ★★★★☆
                                                <span class="ml-1 text-white/70">4.2</span>
                                            </span>
                                            <a href="/booking/<%= Home._id %>" class="px-2 py-1 sm:px-3 sm:py-1.5 lg:px-4 lg:py-2 rounded text-white font-medium text-xs sm:text-sm lg:text-sm backdrop-blur-lg bg-white/20 border border-white/10 shadow-lg transition-all duration-300 hover:scale-105 hover:bg-white/30">
                                                Book
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hill Side Category -->
            <div class="mb-16">
                <div class="flex items-center mb-8">
                    <svg class="w-5 h-5 sm:w-6 lg:w-6 text-blue-400 mr-2 sm:mr-3 lg:mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>
                    </svg>
                    <h2 class="text-lg sm:text-2xl lg:text-3xl font-bold text-white/90">Hill Side Retreats</h2>
                </div>

                <div class="relative">
                    <div class="overflow-x-auto scrollbar-hide">
                        <div class="flex gap-2 sm:gap-4 lg:gap-6 pb-2 sm:pb-3 lg:pb-4 w-max px-2 sm:px-3 lg:px-4">
                            <% hillyHomes.forEach((Home)=>{ %>
                                <div class="flex-shrink-0 w-48 sm:w-64 lg:w-80 backdrop-blur-md bg-white/10 border border-white/20 rounded-lg sm:rounded-xl lg:rounded-2xl overflow-hidden shadow-lg sm:shadow-lg lg:shadow-xl transition-all duration-300 hover:scale-[1.02] hover:shadow-2xl group">
                                    <div class="relative aspect-video overflow-hidden">
                                        <img 
                                            src="<%= Home.photoUrl %>" 
                                            alt="<%=Home.houseName%>"
                                            class="object-cover w-full h-full transform group-hover:scale-110 transition-transform duration-700"
                                        >
                                        <div class="absolute top-2 right-2 sm:top-3 sm:right-3 lg:top-4 lg:right-4">
                                            <span class="px-2 py-1 sm:px-3 sm:py-1.5 lg:px-4 lg:py-2 rounded-full text-xs sm:text-sm lg:text-sm backdrop-blur-md bg-black/50 text-white/90 border border-white/10">
                                                ₹<%= Home.price %> per night
                                            </span>
                                        </div>
                                    </div>

                                    <div class="p-3 sm:p-4 lg:p-6 space-y-2 sm:space-y-3 lg:space-y-4">
                                        <div class="space-y-1 sm:space-y-1.5 lg:space-y-2">
                                            <h2 class="text-sm sm:text-base lg:text-xl font-bold text-white/90 line-clamp-1"><%=Home.houseName%></h2>
                                            <span class="flex items-center text-white/70 text-xs sm:text-sm lg:text-sm">
                                                <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5 lg:w-4 lg:h-4 mr-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                                    <path d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"/>
                                                </svg>
                                                <%= Home.location %>
                                            </span>
                                            <p class="text-gray-400 line-clamp-2 text-xs sm:text-sm lg:text-sm">
                                                <%= Home.description %>
                                            </p>
                                        </div>

                                        <div class="grid grid-cols-3 gap-2 sm:gap-2.5 lg:gap-3 py-2 sm:py-2.5 lg:py-3 border-t border-white/10">
                                            <div class="text-center">
                                                <span class="block text-white/90 font-medium text-xs sm:text-sm lg:text-sm"><%= Home.bedrooms %></span>
                                                <span class="text-xs lg:text-xs text-gray-400">Beds</span>
                                            </div>
                                            <div class="text-center">
                                                <span class="block text-white/90 font-medium text-xs sm:text-sm lg:text-sm"><%= Home.bathrooms %></span>
                                                <span class="text-xs lg:text-xs text-gray-400">Baths</span>
                                            </div>
                                            <div class="text-center">
                                                <span class="block text-white/90 font-medium text-xs sm:text-sm lg:text-sm"><%= Home.squareFt %></span>
                                                <span class="text-xs lg:text-xs text-gray-400">Sq. Ft.</span>
                                            </div>
                                        </div>

                                        <div class="flex items-center justify-between pt-1 sm:pt-1.5 lg:pt-2 gap-1 sm:gap-2 lg:gap-0">
                                            <span class="flex items-center text-yellow-400 text-xs sm:text-sm lg:text-sm">
                                                ★★★★★
                                                <span class="ml-1 text-white/70">4.8</span>
                                            </span>
                                            <a href="/booking/<%= Home._id %>" class="px-2 py-1 sm:px-3 sm:py-1.5 lg:px-4 lg:py-2 rounded text-white font-medium text-xs sm:text-sm lg:text-sm backdrop-blur-lg bg-white/20 border border-white/10 shadow-lg transition-all duration-300 hover:scale-105 hover:bg-white/30">
                                                Book
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <%- include('../partials/footer') %>

    <style>
        .scrollbar-hide {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        .scrollbar-hide::-webkit-scrollbar {
            display: none;
        }
    </style>
</body>
</html>