<%- include('../partials/header') %>
</head>
<body class="bg-gradient-to-br from-gray-900 via-gray-800 to-black min-h-screen scroll-smooth">
   <%- include('../partials/nav.ejs') %>
    
    <div class="container mx-auto px-3 sm:px-4 py-6 sm:py-12 pt-28 sm:pt-32">
        
        <%- include('../partials/searchBar') %>
        <!-- Desktop & Tablet Grid -->
        <div class="hidden sm:grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 md:gap-8 max-w-7xl mx-auto">
            <% if(homes.length === 0){ %>
                <div class="col-span-full text-center py-20">
                    <h2 class="text-xl sm:text-2xl md:text-3xl font-bold text-white/90">
                        No properties found.
                    </h2>
                    <p class="text-gray-400 mt-4 text-sm sm:text-base">
                        Please try searching with different keywords.
                    </p>
                </div>
            <% } %>
            <% homes.forEach((Home)=>{ %>
                <div class="backdrop-blur-md bg-white/10 border border-white/20 rounded-xl sm:rounded-2xl overflow-hidden shadow-xl transition-all duration-300 hover:scale-[1.02] hover:shadow-2xl group">
                    <div class="relative aspect-video overflow-hidden">
                        <img 
                            src="<%= Home.photoUrl %>" 
                            alt="<%=Home.houseName%>"
                            class="object-cover w-full h-full transform group-hover:scale-110 transition-transform duration-700"
                        >
                        <div class="absolute top-2 sm:top-4 right-2 sm:right-4">
                            <span class="px-3 sm:px-4 py-1.5 sm:py-2 rounded-full text-xs sm:text-sm backdrop-blur-md bg-black/50 text-white/90 border border-white/10">
                                ₹<%= Home.price %>/night
                            </span>
                        </div>
                    </div>

                    <div class="p-4 sm:p-6 md:p-8 space-y-3 sm:space-y-6">
                        <div class="space-y-2">
                            <h2 class="text-lg sm:text-xl md:text-2xl font-bold text-white/90 line-clamp-1"><%=Home.houseName%></h2>
                            <div class="flex items-center text-white/70 text-xs sm:text-sm md:text-base gap-1">
                                <svg class="w-4 h-4 sm:w-5 sm:h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"/>
                                </svg>
                                <span class="line-clamp-1"><%= Home.location %></span>
                            </div>
                            <p class="text-gray-400 text-xs sm:text-sm md:text-base line-clamp-2">
                              <%= Home.description %>
                            </p>
                        </div>

                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 sm:gap-3 pt-3 sm:pt-6 border-t border-white/10">
                            
                            <div class="flex items-center justify-center sm:justify-start">
                                <%- include('../partials/favourites', {Home: Home})%>
                            </div>
                            <a href="/homes/<%= Home._id %>" class="px-4 sm:px-6 py-2 sm:py-3 rounded-lg text-white font-medium text-center text-xs sm:text-sm md:text-base backdrop-blur-lg bg-white/20 border border-white/10 shadow-lg transition-all duration-300 hover:scale-105 hover:bg-white/30">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>

        <!-- Mobile Grid (Clean & Minimal) -->
        <div class="sm:hidden grid grid-cols-2 gap-2 sm:gap-4">
            <% homes.forEach((Home)=>{ %>
                <a href="/homes/<%= Home._id %>" class="backdrop-blur-md bg-white/10 border border-white/20 rounded-lg overflow-hidden shadow-lg transition-all duration-300 hover:shadow-xl hover:bg-white/15 group">
                    <!-- Image Container -->
                    <div class="relative w-full h-40 overflow-hidden">
                        <img 
                            src="<%= Home.photoUrl %>" 
                            alt="<%=Home.houseName%>"
                            class="object-cover w-full h-full transform group-hover:scale-110 transition-transform duration-700"
                        >
                        <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
                        
                        <!-- Price Badge -->
                        <div class="absolute bottom-3 right-3">
                            <span class="px-3 py-1.5 rounded-full text-xs font-semibold backdrop-blur-md bg-black/60 text-white/90 border border-white/10">
                                ₹<%= Home.price %>
                            </span>
                        </div>

                        <!-- Favorite Button -->
                        <div class="absolute top-3 right-3">
                            <%- include('../partials/favourites', {Home: Home})%>
                        </div>
                    </div>

                    <!-- Info Container -->
                    <div class="p-4 space-y-2.5">
                        <div class="space-y-1.5">
                            <h2 class="text-base font-bold text-white/90 line-clamp-1"><%=Home.houseName%></h2>
                            
                            <div class="flex items-center text-white/70 text-xs gap-1">
                                <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"/>
                                </svg>
                                <span class="line-clamp-1"><%= Home.location %></span>
                            </div>

                            <p class="text-gray-400 text-xs line-clamp-2 leading-relaxed">
                              <%= Home.description %>
                            </p>
                        </div>

                        <!-- CTA Button -->
                        <div class="pt-2">
                            <div class="px-4 py-2.5 rounded-md text-white font-medium text-center text-xs backdrop-blur-lg bg-blue-600/80 border border-blue-500/30 transition-all duration-300">
                                View Details →
                            </div>
                        </div>
                    </div>
                </a>
            <% }) %>
        </div>
    </div>
    <!-- Footer -->
    <%- include('../partials/footer') %>
</body>
</html>