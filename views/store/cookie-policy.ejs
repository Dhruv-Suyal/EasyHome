<%- include('../partials/header') %>
</head>
<body class="bg-gradient-to-br from-gray-900 via-gray-800 to-black min-h-screen scroll-smooth">
   <%- include('../partials/nav.ejs') %>
    
    <div class="container mx-auto px-3 sm:px-4 py-6 sm:py-12 pt-28 sm:pt-32">
        <!-- Header Section -->
        <div class="text-center space-y-3 sm:space-y-6 mb-8 sm:mb-16 max-w-3xl mx-auto">
            <div class="inline-block mb-4">
                <span class="px-4 py-2 rounded-full text-sm font-semibold backdrop-blur-md bg-amber-500/20 text-amber-400 border border-amber-500/30">
                    Cookie Settings
                </span>
            </div>
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white/90">
                Cookie Policy
            </h1>
            <p class="text-gray-400 text-sm sm:text-base md:text-lg leading-relaxed">
                This Cookie Policy explains how easyHome uses cookies and similar tracking technologies to enhance your browsing experience and provide better services.
            </p>
            <div class="pt-4 text-xs sm:text-sm text-gray-500">
                Last updated: December 2024
            </div>
        </div>

        <!-- Content Section -->
        <div class="max-w-4xl mx-auto">
            <!-- Cookie Policy Sections -->
            <div class="space-y-6 sm:space-y-8">

                <!-- 1. What are Cookies? -->
                <div class="backdrop-blur-md bg-white/5 border border-white/10 rounded-xl sm:rounded-2xl p-6 sm:p-8 hover:bg-white/[0.08] transition-all duration-300">
                    <div class="flex gap-4 sm:gap-6">
                        <div class="flex-shrink-0">
                            <div class="flex items-center justify-center h-10 w-10 sm:h-12 sm:w-12 rounded-lg bg-blue-500/20 border border-blue-500/30">
                                <span class="text-lg sm:text-xl font-bold text-blue-400">1</span>
                            </div>
                        </div>
                        <div class="flex-1">
                            <h2 class="text-xl sm:text-2xl font-bold text-white/90 mb-3">What are Cookies?</h2>
                            <p class="text-gray-400 text-sm sm:text-base leading-relaxed">
                                Cookies are small text files that are stored on your device (computer, tablet, or mobile phone) when you visit easyHome. They help us recognize you on future visits and enhance your experience on our platform. Cookies are widely used in web browsers and do not contain personally identifying information unless you explicitly provide it.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- 2. Types of Cookies We Use -->
                <div class="backdrop-blur-md bg-white/5 border border-white/10 rounded-xl sm:rounded-2xl p-6 sm:p-8 hover:bg-white/[0.08] transition-all duration-300">
                    <div class="flex gap-4 sm:gap-6">
                        <div class="flex-shrink-0">
                            <div class="flex items-center justify-center h-10 w-10 sm:h-12 sm:w-12 rounded-lg bg-emerald-500/20 border border-emerald-500/30">
                                <span class="text-lg sm:text-xl font-bold text-emerald-400">2</span>
                            </div>
                        </div>
                        <div class="flex-1">
                            <h2 class="text-xl sm:text-2xl font-bold text-white/90 mb-4">Types of Cookies We Use</h2>
                            
                            <!-- Essential Cookies -->
                            <div class="space-y-4">
                                <div class="bg-white/5 border border-emerald-500/20 rounded-lg p-4">
                                    <div class="flex items-start gap-3 mb-2">
                                        <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/30 text-emerald-300 border border-emerald-500/50">Essential</span>
                                        <h3 class="text-lg font-bold text-white/90">Essential Cookies</h3>
                                    </div>
                                    <p class="text-gray-400 text-sm leading-relaxed mb-2">
                                        These cookies are necessary for the website to function properly. They enable you to navigate the site and use its features.
                                    </p>
                                    <p class="text-gray-500 text-xs"><strong>Examples:</strong> Session ID, authentication tokens, CSRF protection</p>
                                </div>

                                <!-- Performance Cookies -->
                                <div class="bg-white/5 border border-blue-500/20 rounded-lg p-4">
                                    <div class="flex items-start gap-3 mb-2">
                                        <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-blue-500/30 text-blue-300 border border-blue-500/50">Performance</span>
                                        <h3 class="text-lg font-bold text-white/90">Performance Cookies</h3>
                                    </div>
                                    <p class="text-gray-400 text-sm leading-relaxed mb-2">
                                        These cookies help us understand how you use easyHome by collecting information about pages visited and actions taken.
                                    </p>
                                    <p class="text-gray-500 text-xs"><strong>Examples:</strong> Google Analytics, page views, time on site, bounce rate</p>
                                </div>

                                <!-- Functional Cookies -->
                                <div class="bg-white/5 border border-purple-500/20 rounded-lg p-4">
                                    <div class="flex items-start gap-3 mb-2">
                                        <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-purple-500/30 text-purple-300 border border-purple-500/50">Functional</span>
                                        <h3 class="text-lg font-bold text-white/90">Functional Cookies</h3>
                                    </div>
                                    <p class="text-gray-400 text-sm leading-relaxed mb-2">
                                        These cookies remember your preferences and choices to provide a more personalized experience.
                                    </p>
                                    <p class="text-gray-500 text-xs"><strong>Examples:</strong> Language preferences, saved searches, user preferences</p>
                                </div>

                                <!-- Marketing Cookies -->
                                <div class="bg-white/5 border border-pink-500/20 rounded-lg p-4">
                                    <div class="flex items-start gap-3 mb-2">
                                        <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-pink-500/30 text-pink-300 border border-pink-500/50">Marketing</span>
                                        <h3 class="text-lg font-bold text-white/90">Marketing Cookies</h3>
                                    </div>
                                    <p class="text-gray-400 text-sm leading-relaxed mb-2">
                                        These cookies track your activity to deliver personalized advertisements and measure marketing effectiveness.
                                    </p>
                                    <p class="text-gray-500 text-xs"><strong>Examples:</strong> Facebook Pixel, Google Ads, conversion tracking</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. Duration of Cookies -->
                <div class="backdrop-blur-md bg-white/5 border border-white/10 rounded-xl sm:rounded-2xl p-6 sm:p-8 hover:bg-white/[0.08] transition-all duration-300">
                    <div class="flex gap-4 sm:gap-6">
                        <div class="flex-shrink-0">
                            <div class="flex items-center justify-center h-10 w-10 sm:h-12 sm:w-12 rounded-lg bg-amber-500/20 border border-amber-500/30">
                                <span class="text-lg sm:text-xl font-bold text-amber-400">3</span>
                            </div>
                        </div>
                        <div class="flex-1">
                            <h2 class="text-xl sm:text-2xl font-bold text-white/90 mb-3">Duration of Cookies</h2>
                            <div class="text-gray-400 text-sm sm:text-base space-y-3 leading-relaxed">
                                <p><strong class="text-white/80">Session Cookies:</strong> These expire when you close your browser. They are temporary and help with navigation.</p>
                                <p><strong class="text-white/80">Persistent Cookies:</strong> These remain on your device for a specified period (typically 1-12 months) or until you manually delete them.</p>
                                <p class="text-xs text-gray-500">Most of our cookies expire within 12 months. You can view and delete cookies through your browser settings.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 4. Third-Party Cookies -->
                <div class="backdrop-blur-md bg-white/5 border border-white/10 rounded-xl sm:rounded-2xl p-6 sm:p-8 hover:bg-white/[0.08] transition-all duration-300">
                    <div class="flex gap-4 sm:gap-6">
                        <div class="flex-shrink-0">
                            <div class="flex items-center justify-center h-10 w-10 sm:h-12 sm:w-12 rounded-lg bg-cyan-500/20 border border-cyan-500/30">
                                <span class="text-lg sm:text-xl font-bold text-cyan-400">4</span>
                            </div>
                        </div>
                        <div class="flex-1">
                            <h2 class="text-xl sm:text-2xl font-bold text-white/90 mb-3">Third-Party Cookies</h2>
                            <p class="text-gray-400 text-sm sm:text-base leading-relaxed mb-4">
                                easyHome works with trusted third-party services that may set their own cookies:
                            </p>
                            <ul class="text-gray-400 text-sm sm:text-base space-y-2 leading-relaxed">
                                <li class="flex gap-3">
                                    <span class="text-cyan-400 flex-shrink-0">•</span>
                                    <span><strong>Google Analytics:</strong> Analyzes website traffic and user behavior</span>
                                </li>
                                <li class="flex gap-3">
                                    <span class="text-cyan-400 flex-shrink-0">•</span>
                                    <span><strong>Razorpay:</strong> Processes secure payments and transactions</span>
                                </li>
                                <li class="flex gap-3">
                                    <span class="text-cyan-400 flex-shrink-0">•</span>
                                    <span><strong>Social Media Platforms:</strong> Facebook, Twitter, LinkedIn for integration and tracking</span>
                                </li>
                                <li class="flex gap-3">
                                    <span class="text-cyan-400 flex-shrink-0">•</span>
                                    <span><strong>Email Services:</strong> For newsletter and communication tracking</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- 5. Managing Your Cookies -->
                <div class="backdrop-blur-md bg-white/5 border border-white/10 rounded-xl sm:rounded-2xl p-6 sm:p-8 hover:bg-white/[0.08] transition-all duration-300">
                    <div class="flex gap-4 sm:gap-6">
                        <div class="flex-shrink-0">
                            <div class="flex items-center justify-center h-10 w-10 sm:h-12 sm:w-12 rounded-lg bg-green-500/20 border border-green-500/30">
                                <span class="text-lg sm:text-xl font-bold text-green-400">5</span>
                            </div>
                        </div>
                        <div class="flex-1">
                            <h2 class="text-xl sm:text-2xl font-bold text-white/90 mb-3">Managing Your Cookies</h2>
                            <p class="text-gray-400 text-sm sm:text-base leading-relaxed mb-4">
                                You have full control over cookies on your device:
                            </p>
                            <div class="space-y-3">
                                <div class="bg-white/5 border border-white/10 rounded-lg p-4">
                                    <h3 class="text-white/90 font-semibold mb-2 text-sm">Browser Settings</h3>
                                    <p class="text-gray-400 text-xs leading-relaxed">
                                        You can adjust cookie settings in your browser preferences. Most browsers allow you to refuse cookies or alert you when a cookie is being sent. However, blocking essential cookies may affect website functionality.
                                    </p>
                                </div>
                                <div class="bg-white/5 border border-white/10 rounded-lg p-4">
                                    <h3 class="text-white/90 font-semibold mb-2 text-sm">Delete Cookies</h3>
                                    <p class="text-gray-400 text-xs leading-relaxed">
                                        You can delete existing cookies from your device at any time through browser settings. Note that this may affect your browsing experience and login status on easyHome.
                                    </p>
                                </div>
                                <div class="bg-white/5 border border-white/10 rounded-lg p-4">
                                    <h3 class="text-white/90 font-semibold mb-2 text-sm">Do Not Track</h3>
                                    <p class="text-gray-400 text-xs leading-relaxed">
                                        If your browser supports "Do Not Track," you can enable it. However, easyHome and third-party services may not recognize this preference.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 6. Browser-Specific Instructions -->
                <div class="backdrop-blur-md bg-white/5 border border-white/10 rounded-xl sm:rounded-2xl p-6 sm:p-8 hover:bg-white/[0.08] transition-all duration-300">
                    <div class="flex gap-4 sm:gap-6">
                        <div class="flex-shrink-0">
                            <div class="flex items-center justify-center h-10 w-10 sm:h-12 sm:w-12 rounded-lg bg-purple-500/20 border border-purple-500/30">
                                <span class="text-lg sm:text-xl font-bold text-purple-400">6</span>
                            </div>
                        </div>
                        <div class="flex-1">
                            <h2 class="text-xl sm:text-2xl font-bold text-white/90 mb-4">How to Manage Cookies in Popular Browsers</h2>
                            
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <div class="bg-white/5 border border-white/10 rounded-lg p-3">
                                    <h3 class="text-white/90 font-semibold text-sm mb-2 flex items-center gap-2">
                                        <span class="text-lg">🔵</span> Chrome
                                    </h3>
                                    <p class="text-gray-400 text-xs">Settings → Privacy → Cookies and other site data</p>
                                </div>
                                <div class="bg-white/5 border border-white/10 rounded-lg p-3">
                                    <h3 class="text-white/90 font-semibold text-sm mb-2 flex items-center gap-2">
                                        <span class="text-lg">🦊</span> Firefox
                                    </h3>
                                    <p class="text-gray-400 text-xs">Options → Privacy → Cookies and Site Data</p>
                                </div>
                                <div class="bg-white/5 border border-white/10 rounded-lg p-3">
                                    <h3 class="text-white/90 font-semibold text-sm mb-2 flex items-center gap-2">
                                        <span class="text-lg">🧭</span> Safari
                                    </h3>
                                    <p class="text-gray-400 text-xs">Preferences → Privacy → Cookies and website data</p>
                                </div>
                                <div class="bg-white/5 border border-white/10 rounded-lg p-3">
                                    <h3 class="text-white/90 font-semibold text-sm mb-2 flex items-center gap-2">
                                        <span class="text-lg">🌐</span> Edge
                                    </h3>
                                    <p class="text-gray-400 text-xs">Settings → Privacy → Cookies and site data</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 7. Cookie Consent -->
                <div class="backdrop-blur-md bg-white/5 border border-white/10 rounded-xl sm:rounded-2xl p-6 sm:p-8 hover:bg-white/[0.08] transition-all duration-300">
                    <div class="flex gap-4 sm:gap-6">
                        <div class="flex-shrink-0">
                            <div class="flex items-center justify-center h-10 w-10 sm:h-12 sm:w-12 rounded-lg bg-red-500/20 border border-red-500/30">
                                <span class="text-lg sm:text-xl font-bold text-red-400">7</span>
                            </div>
                        </div>
                        <div class="flex-1">
                            <h2 class="text-xl sm:text-2xl font-bold text-white/90 mb-3">Cookie Consent</h2>
                            <p class="text-gray-400 text-sm sm:text-base leading-relaxed mb-3">
                                When you first visit easyHome, you'll see a cookie consent banner. By using our website, you consent to our use of cookies as described in this policy. You can withdraw or modify your consent at any time.
                            </p>
                            <div class="bg-white/5 border border-white/10 rounded-lg p-4">
                                <p class="text-gray-400 text-xs sm:text-sm">
                                    <strong class="text-white/80">Essential cookies</strong> are always enabled as they're necessary for the website to function. You can choose to accept or reject performance, functional, and marketing cookies.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 8. Updates to Cookie Policy -->
                <div class="backdrop-blur-md bg-white/5 border border-white/10 rounded-xl sm:rounded-2xl p-6 sm:p-8 hover:bg-white/[0.08] transition-all duration-300">
                    <div class="flex gap-4 sm:gap-6">
                        <div class="flex-shrink-0">
                            <div class="flex items-center justify-center h-10 w-10 sm:h-12 sm:w-12 rounded-lg bg-indigo-500/20 border border-indigo-500/30">
                                <span class="text-lg sm:text-xl font-bold text-indigo-400">8</span>
                            </div>
                        </div>
                        <div class="flex-1">
                            <h2 class="text-xl sm:text-2xl font-bold text-white/90 mb-3">Updates to This Cookie Policy</h2>
                            <p class="text-gray-400 text-sm sm:text-base leading-relaxed">
                                easyHome may update this Cookie Policy from time to time to reflect changes in our practices or for other operational, legal, or regulatory reasons. We encourage you to review this policy periodically. Continued use of our website following any changes indicates your acceptance of the updated policy.
                            </p>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Contact Section -->
            <div class="mt-12 sm:mt-16 p-6 sm:p-8 backdrop-blur-md bg-gradient-to-r from-amber-500/10 to-orange-500/10 border border-amber-500/30 rounded-xl sm:rounded-2xl">
                <h3 class="text-xl sm:text-2xl font-bold text-white/90 mb-4">Questions About Our Cookies?</h3>
                <p class="text-gray-400 text-sm sm:text-base mb-6">
                    If you have any questions or concerns about our use of cookies, please don't hesitate to reach out. Our privacy team is here to help.
                </p>
                <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
                    <a href="/contact" class="px-6 py-3 rounded-lg text-white font-medium text-center backdrop-blur-lg bg-amber-600/80 border border-amber-500/30 hover:bg-amber-600/90 transition-all duration-300">
                        Contact Us
                    </a>
                    <a href="/privacy-policy" class="px-6 py-3 rounded-lg text-white font-medium text-center backdrop-blur-lg bg-white/10 border border-white/20 hover:bg-white/15 transition-all duration-300">
                        Privacy Policy
                    </a>
                    <a href="/" class="px-6 py-3 rounded-lg text-white font-medium text-center backdrop-blur-lg bg-white/10 border border-white/20 hover:bg-white/15 transition-all duration-300">
                        Back to Home
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <%- include('../partials/footer') %>
</body>
</html>
