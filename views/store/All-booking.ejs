<%- include('../partials/header') %>
</head>
<body class="bg-gradient-to-br from-gray-900 via-gray-800 to-black min-h-screen scroll-smooth">
    <%- include('../partials/nav') %>
    
    <div class="container mx-auto px-3 sm:px-4 py-6 sm:py-12 pt-28 sm:pt-32">
        <div class="text-center space-y-2 sm:space-y-4 mb-8 sm:mb-16">
            <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-white/90">
                My Bookings
            </h1>
            <p class="text-gray-400 max-w-2xl mx-auto text-xs sm:text-sm md:text-base">
                View and manage all your reservations
            </p>
        </div>

        <% if(bookings && bookings.length > 0) { %>
            <!-- Desktop & Tablet Grid - 2 Columns -->
            <div class="hidden sm:grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 md:gap-8 max-w-7xl mx-auto">
                <% bookings.forEach((booking) => { %>
                    <% if(booking.status != 'Cancelled' && booking.status !='Completed') { %>
                    <div class="backdrop-blur-md bg-white/10 border border-white/20 rounded-xl sm:rounded-2xl overflow-hidden shadow-xl transition-all duration-300 hover:scale-[1.02] hover:shadow-2xl group">
                        <!-- Image Container with Overlays -->
                        <div class="relative aspect-video overflow-hidden">
                            <img 
                                src="<%= booking.home.photoUrl %>" 
                                alt="<%= booking.home.houseName %>"
                                class="object-cover w-full h-full transform group-hover:scale-110 transition-transform duration-700"
                            >
                            <!-- Booking Status Badge - Top Right -->
                            <div class="absolute top-2 sm:top-4 right-2 sm:right-4">
                                <% if(booking.status === 'Confirmed') { %>
                                    <span class="px-3 sm:px-4 py-1.5 sm:py-2 rounded-full text-xs sm:text-sm backdrop-blur-md bg-emerald-600/80 text-white/90 border border-emerald-500/30 font-semibold">
                                        ✓ Confirmed
                                    </span>
                                <% } else if(booking.status === 'Pending') { %>
                                    <span class="px-3 sm:px-4 py-1.5 sm:py-2 rounded-full text-xs sm:text-sm backdrop-blur-md bg-yellow-600/80 text-white/90 border border-yellow-500/30 font-semibold">
                                        ⏳ Pending
                                    </span>
                                <% } %>
                            </div>
                        </div>

                        <!-- Details Section -->
                        <div class="p-4 sm:p-6 md:p-8 space-y-3 sm:space-y-6">
                            <div class="space-y-2">
                                <h2 class="text-lg sm:text-xl md:text-2xl font-bold text-white/90 line-clamp-1"><%= booking.home.houseName %></h2>
                                <div class="flex items-center text-white/70 text-xs sm:text-sm md:text-base gap-1">
                                    <svg class="w-4 h-4 sm:w-5 sm:h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"/>
                                    </svg>
                                    <span class="line-clamp-1"><%= booking.home.location %></span>
                                </div>
                            </div>

                            <!-- Booking Dates + View button in same row (desktop only layout) -->
                            <div class="grid grid-cols-3 md:grid-cols-4 gap-3 text-xs sm:text-sm">

                            <!-- Check-in -->
                                <div class="bg-gray-700/40 border border-white/10 rounded-xl p-3">
                                    <p class="text-gray-400 font-semibold mb-1">Check-in</p>
                                    <p class="text-white font-medium">
                                        <%= new Date(booking.checkInDate).toLocaleDateString('en-IN', {day: '2-digit', month: 'short'}) %>
                                    </p>
                                </div>

                                <!-- Check-out -->
                                <div class="bg-gray-700/40 border border-white/10 rounded-xl p-3">
                                    <p class="text-gray-400 font-semibold mb-1">Check-out</p>
                                    <p class="text-white font-medium">
                                        <%= new Date(booking.checkOutDate).toLocaleDateString('en-IN', {day: '2-digit', month: 'short'}) %>
                                    </p>
                                </div>

                                <!-- Guests -->
                                <div class="bg-gray-700/40 border border-white/10 rounded-xl p-3">
                                    <p class="text-gray-400 font-semibold mb-1">Guests</p>
                                    <p class="text-white font-medium">
                                        <%= booking.numberOfPeople %>
                                    </p>
                                </div>

                                <!-- View Details CARD styled like tiles (desktop look only) -->
                                <a href="bookingDetails/<%= booking._id %>" 
                                class="bg-blue-600/80 hover:bg-blue-600 transition border border-blue-500/40
                                        rounded-xl p-3 flex items-center justify-center font-semibold text-white
                                        hidden md:flex">
                                    View Details →
                                </a>
                            </div>


                            
                        </div>
                    </div>
                    <% }%>
                <% })%>
            </div>
            <!-- Mobile Grid - 2 Columns (Clean & Minimal) -->
     <!-- Mobile Grid - 2 Columns -->
<div class="sm:hidden grid grid-cols-2 gap-3 px-2">

    <% bookings.forEach((booking) => { %>
    <% if(booking.status != 'Cancelled' && booking.status !='Completed') { %>

    <div class="backdrop-blur-md bg-white/10 border border-white/20 rounded-lg overflow-hidden shadow-lg transition-all duration-300 hover:shadow-xl hover:bg-white/15 group">

        <!-- Image -->
        <div class="relative w-full aspect-[4/3] overflow-hidden">
            <img 
                src="<%= booking.home.photoUrl %>"
                alt="<%= booking.home.houseName %>"
                class="object-cover w-full h-full transition-transform duration-700 group-hover:scale-110"
            >
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>

            <!-- Status -->
            <div class="absolute top-2 right-2">
                <% if(booking.status === 'Confirmed') { %>
                    <span class="px-2 py-1 rounded-full text-[10px] font-semibold backdrop-blur-md bg-emerald-600/80 text-white border border-emerald-500/30">
                        ✓ Confirmed
                    </span>
                <% } else if(booking.status === 'Pending') { %>
                    <span class="px-2 py-1 rounded-full text-[10px] font-semibold backdrop-blur-md bg-yellow-600/80 text-white border border-yellow-500/30">
                        ⏳ Pending
                    </span>
                <% } %>
            </div>
        </div>

        <!-- Info -->
        <div class="p-3 space-y-2">

            <h2 class="text-sm font-bold text-white/90 line-clamp-1">
                <%= booking.home.houseName %>
            </h2>

            <div class="flex items-center text-white/70 text-[11px] gap-1">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"/>
                </svg>
                <span class="line-clamp-1"><%= booking.home.location %></span>
            </div>

            <!-- Quick Info -->
            <div class="text-[11px] space-y-1">
                <div class="flex justify-between">
                    <span class="text-gray-400">Check-in:</span>
                    <span class="text-white/80">
                        <%= new Date(booking.checkInDate).toLocaleDateString('en-IN', {day: '2-digit', month: 'short'}) %>
                    </span>
                </div>

                <div class="flex justify-between">
                    <span class="text-gray-400">Check-out:</span>
                    <span class="text-white/80">
                        <%= new Date(booking.checkOutDate).toLocaleDateString('en-IN', {day: '2-digit', month: 'short'}) %>
                    </span>
                </div>
            </div>

            <!-- Button -->
            <a href="bookingDetails/<%= booking._id %>">
                <button class="w-full mt-2 px-3 py-2 rounded-md bg-blue-600/80 hover:bg-blue-600 text-white text-xs font-medium transition">
                    View Details
                </button>
            </a>

        </div>

    </div>

    <% } %>
    <% }) %>
            </div>
        <% } else { %>
            <!-- Empty State -->
            <div class="max-w-2xl mx-auto">
                <div class="backdrop-blur-md bg-white/10 border border-white/20 rounded-xl sm:rounded-2xl overflow-hidden shadow-xl p-8 sm:p-12">
                    <div class="text-center space-y-4 sm:space-y-6">
                        <svg class="w-16 sm:w-20 h-16 sm:h-20 mx-auto text-gray-400 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <div>
                            <h2 class="text-xl sm:text-2xl font-bold text-white/90">No Bookings Yet</h2>
                            <p class="text-gray-400 text-xs sm:text-sm mt-2">You haven't made any bookings. Start exploring our properties today!</p>
                        </div>
                    </div>
                </div>

                <div class="text-center mt-6 sm:mt-8">
                    <a href="/" class="inline-block px-6 sm:px-8 py-2.5 sm:py-3 rounded-lg text-white font-medium text-sm sm:text-base backdrop-blur-lg bg-blue-600/80 border border-blue-500/30 shadow-lg transition-all duration-300 hover:scale-105 hover:bg-blue-600">
                        Explore Properties
                    </a>
                </div>
            </div>
        <% } %>
    </div>
    <%- include('../partials/footer') %>
    <script>
         
        function toggleCancelForm(bookingId) {
            const form = document.getElementById(`cancel-form-${bookingId}`);
            if (form) {
                form.classList.toggle('hidden');
                // Scroll to form if opening
                if (!form.classList.contains('hidden')) {
                    form.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            }
        }

        function submitCancelForm(event, bookingId) {
            event.preventDefault();
            
            const reason = document.getElementById(`cancel-reason-${bookingId}`).value;
            
            if (!reason.trim()) {
                alert('Please provide a reason for cancellation');
                return;
            }
        }
    </script>
</body>
</html>