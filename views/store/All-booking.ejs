<%- include('../partials/header') %>
</head>
<body class="bg-gradient-to-br from-gray-900 via-gray-800 to-black min-h-screen scroll-smooth">
    <%- include('../partials/nav') %>
    
    <div class="container mx-auto px-3 sm:px-4 py-6 sm:py-12 pt-28 sm:pt-32">
        <div class="text-center space-y-2 sm:space-y-4 mb-8 sm:mb-16">
            <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-white/90">
                My Bookings
            </h1>
            <p class="text-gray-400 max-w-2xl mx-auto text-xs sm:text-sm md:text-base">
                View and manage all your reservations
            </p>
        </div>

        <% if(bookings && bookings.length > 0) { %>
            <!-- Tabs for Desktop -->
            <div class="hidden sm:flex justify-center gap-2 sm:gap-4 mb-8 sm:mb-12">
                <button onclick="filterBookings('all')" class="filter-btn px-4 sm:px-6 py-2 sm:py-3 rounded-lg text-sm sm:text-base font-medium backdrop-blur-lg bg-blue-600/80 border border-blue-500/30 text-white transition-all duration-300 hover:scale-105" data-filter="all">
                    All Bookings
                </button>
                <button onclick="filterBookings('pending')" class="filter-btn px-4 sm:px-6 py-2 sm:py-3 rounded-lg text-sm sm:text-base font-medium backdrop-blur-lg bg-white/10 border border-white/20 text-white/70 transition-all duration-300 hover:scale-105" data-filter="pending">
                    Pending
                </button>
                <button onclick="filterBookings('confirmed')" class="filter-btn px-4 sm:px-6 py-2 sm:py-3 rounded-lg text-sm sm:text-base font-medium backdrop-blur-lg bg-white/10 border border-white/20 text-white/70 transition-all duration-300 hover:scale-105" data-filter="confirmed">
                    Confirmed
                </button>
            </div>

            <!-- Mobile Filter Dropdown -->
            <div class="sm:hidden mb-6 sm:mb-8">
                <select id="mobileFilter" onchange="filterBookings(this.value)" class="w-full px-3 sm:px-4 py-2.5 sm:py-3 rounded-lg text-sm sm:text-base backdrop-blur-lg bg-white/10 border border-white/20 text-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all duration-300 appearance-none cursor-pointer">
                    <option value="all">All Bookings</option>
                    <option value="pending">Pending</option>
                    <option value="confirmed">Confirmed</option>
                </select>
            </div>

            <!-- Bookings Grid -->
            <div class="grid grid-cols-1 gap-4 sm:gap-6 md:gap-8 max-w-5xl mx-auto">
                <% bookings.forEach((booking) => { %>
                    <% if(booking.status != 'Cancelled') { %>
                    <div class="booking-card" data-status="<%= booking.status ? booking.status.toLowerCase() : 'pending' %>">
                        <div class="backdrop-blur-md bg-white/10 border border-white/20 rounded-xl sm:rounded-2xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-300">
                            <!-- Desktop Layout -->
                            <div class="hidden sm:grid grid-cols-1 md:grid-cols-4 gap-0">
                                <!-- Property Image -->
                                <div class="relative aspect-square overflow-hidden group">
                                    <img 
                                        src="<%= booking.home.photoUrl %>" 
                                        alt="<%= booking.home.houseName %>"
                                        class="object-cover w-full h-full transform group-hover:scale-110 transition-transform duration-700"
                                    >
                                </div>

                                <!-- Booking Details -->
                                <div class="md:col-span-2 p-4 sm:p-6 space-y-3 sm:space-y-4">
                                    <div>
                                        <h3 class="text-lg sm:text-xl font-bold text-white/90 line-clamp-1">
                                            <%= booking.home.houseName %>
                                        </h3>
                                        <p class="text-gray-400 text-xs sm:text-sm line-clamp-1">
                                            <%= booking.home.location %>
                                        </p>
                                    </div>

                                    <div class="space-y-2 sm:space-y-2">
                                        <div class="flex justify-between text-xs sm:text-sm">
                                            <span class="text-gray-400">Check-in:</span>
                                            <span class="text-white/70 font-medium">
                                                <%= new Date(booking.checkInDate).toLocaleDateString('en-IN', {day: '2-digit', month: 'short', year: 'numeric'}) %>
                                            </span>
                                        </div>
                                        <div class="flex justify-between text-xs sm:text-sm">
                                            <span class="text-gray-400">Check-out:</span>
                                            <span class="text-white/70 font-medium">
                                                <%= new Date(booking.checkOutDate).toLocaleDateString('en-IN', {day: '2-digit', month: 'short', year: 'numeric'}) %>
                                            </span>
                                        </div>
                                        <div class="flex justify-between text-xs sm:text-sm">
                                            <span class="text-gray-400">Guests:</span>
                                            <span class="text-white/70 font-medium"><%= booking.numberOfPeople %> People</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Status & Price & Cancel Button -->
                                <div class="p-4 sm:p-6 flex flex-col justify-between items-end border-l border-white/10">
                                    <div>
                                        <% if(booking.status === 'Confirmed') { %>
                                            <span class="inline-block px-3 sm:px-4 py-1.5 sm:py-2 rounded-full text-xs sm:text-sm font-semibold backdrop-blur-md bg-emerald-600/30 border border-emerald-500/50 text-emerald-300">
                                                ✓ Confirmed
                                            </span>
                                        <% } else if(booking.status === 'Pending') { %>
                                            <span class="inline-block px-3 sm:px-4 py-1.5 sm:py-2 rounded-full text-xs sm:text-sm font-semibold backdrop-blur-md bg-yellow-600/30 border border-yellow-500/50 text-yellow-300">
                                                ⏳ Pending
                                            </span>
                                        <% } %> 
                                    </div>
                                    <div class="text-right mt-3 sm:mt-4 w-full">
                                        <p class="text-xs sm:text-sm text-gray-400">Total Amount</p>
                                        <p class="text-lg sm:text-xl md:text-2xl font-bold text-emerald-400 mb-4">
                                            ₹<%= booking.totalPrice || (booking.home.price * Math.ceil((new Date(booking.checkOutDate) - new Date(booking.checkInDate)) / (1000 * 60 * 60 * 24))) %>
                                        </p>
                                        
                                        <!-- Cancel Button -->
                                        <% if(booking.status !== 'Cancelled') { %>
                                            <button onclick="toggleCancelForm('<%= booking._id %>')" class="w-full px-3 py-2 rounded-lg text-xs sm:text-sm font-medium bg-red-600/80 hover:bg-red-600 text-white transition-all duration-300 cursor-pointer border border-red-500/30">
                                                Cancel Booking
                                            </button>
                                        <% } else { %>
                                            <span class="text-xs text-gray-400">This booking is cancelled</span>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Mobile Layout -->
                            <div class="sm:hidden">
                                <div class="relative aspect-video overflow-hidden group">
                                    <img 
                                        src="<%= booking.home.photoUrl %>" 
                                        alt="<%= booking.home.houseName %>"
                                        class="object-cover w-full h-full transform group-hover:scale-110 transition-transform duration-700"
                                    >
                                    <div class="absolute top-2 right-2">
                                        <% if(booking.status === 'Confirmed') { %>
                                            <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold backdrop-blur-md bg-emerald-600/30 border border-emerald-500/50 text-emerald-300">
                                                ✓ Confirmed
                                            </span>
                                        <% } else if(booking.status === 'Pending') { %>
                                            <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold backdrop-blur-md bg-yellow-600/30 border border-yellow-500/50 text-yellow-300">
                                                ⏳ Pending
                                            </span>
                                        <% } else if(booking.status === 'Completed') { %>
                                            <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold backdrop-blur-md bg-blue-600/30 border border-blue-500/50 text-blue-300">
                                                ✓ Completed
                                            </span>
                                        <% } else { %>
                                            <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold backdrop-blur-md bg-red-600/30 border border-red-500/50 text-red-300">
                                                ✗ Cancelled
                                            </span>
                                        <% } %>
                                    </div>
                                </div>

                                <div class="p-3 space-y-2.5">
                                    <div>
                                        <h3 class="text-base font-bold text-white/90 line-clamp-1">
                                            <%= booking.home.houseName %>
                                        </h3>
                                        <p class="text-gray-400 text-xs line-clamp-1">
                                            <%= booking.home.location %>
                                        </p>
                                    </div>

                                    <div class="space-y-1.5 text-xs border-y border-white/10 py-2.5">
                                        <div class="flex justify-between">
                                            <span class="text-gray-400">Check-in:</span>
                                            <span class="text-white/70 font-medium">
                                                <%= new Date(booking.checkInDate).toLocaleDateString('en-IN', {day: '2-digit', month: 'short'}) %>
                                            </span>
                                        </div>
                                        <div class="flex justify-between">
                                            <span class="text-gray-400">Check-out:</span>
                                            <span class="text-white/70 font-medium">
                                                <%= new Date(booking.checkOutDate).toLocaleDateString('en-IN', {day: '2-digit', month: 'short'}) %>
                                            </span>
                                        </div>
                                        <div class="flex justify-between">
                                            <span class="text-gray-400">Guests:</span>
                                            <span class="text-white/70 font-medium"><%= booking.numberOfPeople %></span>
                                        </div>
                                    </div>

                                    <div class="flex justify-between items-center pt-1 border-t border-white/10">
                                        <div>
                                            <p class="text-xs text-gray-400">Total Amount</p>
                                            <p class="text-lg font-bold text-emerald-400">
                                                ₹<%= booking.totalPrice || (booking.home.price * Math.ceil((new Date(booking.checkOutDate) - new Date(booking.checkInDate)) / (1000 * 60 * 60 * 24))) %>
                                            </p>
                                        </div>
                                    </div>

                                    <!-- Mobile Cancel Button -->
                                    <div class="pt-2">
                                        <% if(booking.status !== 'Cancelled') { %>
                                            <button onclick="toggleCancelForm('<%= booking._id %>')" class="w-full px-3 py-2.5 rounded-lg text-xs font-medium bg-red-600/80 hover:bg-red-600 text-white transition-all duration-300 cursor-pointer border border-red-500/30">
                                                Cancel Booking
                                            </button>
                                        <% } else { %>
                                            <span class="text-xs text-gray-400">This booking is cancelled</span>
                                        <% } %>
                                    </div>
                                </div>
                            </div>

                            <!-- Cancel Form (Hidden by default) -->
                            <div id="cancel-form-<%= booking._id %>" class="hidden border-t border-white/10 p-4 sm:p-6 bg-red-600/10">
                                <form action="/cancelBooking/<%=booking._id%>" method="POST" class="space-y-4">
                                    <div>
                                        <label class="block text-sm font-medium text-white/90 mb-2">
                                            Why do you want to cancel this booking?
                                        </label>
                                        <textarea 
                                            id="cancel-reason-<%= booking._id %>"
                                            placeholder="Please provide a reason for cancellation..."
                                            class="w-full px-4 py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition-all duration-300 resize-none"
                                            rows="3"
                                            name="reasonForCancellation"
                                            required
                                        ></textarea>
                                    </div>

                                    <div class="flex gap-3 justify-end">
                                        <button 
                                            type="button" 
                                            onclick="toggleCancelForm('<%= booking._id %>')"
                                            class="px-4 py-2.5 rounded-lg text-sm font-medium bg-white/10 hover:bg-white/20 text-white/90 border border-white/20 transition-all duration-300 cursor-pointer"
                                        >
                                            Keep Booking
                                        </button>
                                        <button 
                                            type="submit"
                                            class="px-4 py-2.5 rounded-lg text-sm font-medium bg-red-600/80 hover:bg-red-600 text-white border border-red-500/30 transition-all duration-300 cursor-pointer"
                                        >
                                            Confirm Cancellation
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    <% } %>
                <% }) %>
            </div>
        <% } else { %>
            <!-- Empty State -->
            <div class="max-w-2xl mx-auto">
                <div class="backdrop-blur-md bg-white/10 border border-white/20 rounded-xl sm:rounded-2xl overflow-hidden shadow-xl p-8 sm:p-12">
                    <div class="text-center space-y-4 sm:space-y-6">
                        <svg class="w-16 sm:w-20 h-16 sm:h-20 mx-auto text-gray-400 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <div>
                            <h2 class="text-xl sm:text-2xl font-bold text-white/90">No Bookings Yet</h2>
                            <p class="text-gray-400 text-xs sm:text-sm mt-2">You haven't made any bookings. Start exploring our properties today!</p>
                        </div>
                    </div>
                </div>

                <div class="text-center mt-6 sm:mt-8">
                    <a href="/" class="inline-block px-6 sm:px-8 py-2.5 sm:py-3 rounded-lg text-white font-medium text-sm sm:text-base backdrop-blur-lg bg-blue-600/80 border border-blue-500/30 shadow-lg transition-all duration-300 hover:scale-105 hover:bg-blue-600">
                        Explore Properties
                    </a>
                </div>
            </div>
        <% } %>
    </div>
    <%- include('../partials/footer') %>
    <script>
        function filterBookings(status) {
            const cards = document.querySelectorAll('.booking-card');
            
            cards.forEach(card => {
                if (status === 'all') {
                    card.style.display = 'block';
                } else {
                    const cardStatus = card.getAttribute('data-status');
                    card.style.display = cardStatus === status ? 'block' : 'none';
                }
            });

            // Update active button styling
            document.querySelectorAll('.filter-btn').forEach(btn => {
                if (btn.getAttribute('data-filter') === status) {
                    btn.classList.remove('bg-white/10', 'text-white/70', 'border-white/20');
                    btn.classList.add('bg-blue-600/80', 'text-white', 'border-blue-500/30');
                } else {
                    btn.classList.remove('bg-blue-600/80', 'text-white', 'border-blue-500/30');
                    btn.classList.add('bg-white/10', 'text-white/70', 'border-white/20');
                }
            });
        }

        function toggleCancelForm(bookingId) {
            const form = document.getElementById(`cancel-form-${bookingId}`);
            if (form) {
                form.classList.toggle('hidden');
                // Scroll to form if opening
                if (!form.classList.contains('hidden')) {
                    form.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            }
        }

        function submitCancelForm(event, bookingId) {
            event.preventDefault();
            
            const reason = document.getElementById(`cancel-reason-${bookingId}`).value;
            
            if (!reason.trim()) {
                alert('Please provide a reason for cancellation');
                return;
            }

            // Create and submit form data
            const formData = new FormData();
            formData.append('bookingId', bookingId);
            formData.append('reason', reason);

            // Send to server - adjust the endpoint as needed
            fetch('/cancel-booking', {
                method: 'POST',
                body: formData
            })
            .then(response => {
                if (response.ok) {
                    alert('Booking cancelled successfully');
                    location.reload(); // Reload page to show updated status
                } else {
                    alert('Failed to cancel booking. Please try again.');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred while cancelling the booking');
            });
        }
    </script>
</body>
</html>