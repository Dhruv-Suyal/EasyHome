<%- include('../partials/header') %>
</head>

<body class="bg-gradient-to-br from-gray-950 via-gray-900 to-black text-white min-h-screen">
<%- include('../partials/nav') %>

<div class="pt-28 pb-12 px-4">
  <div class="max-w-5xl mx-auto">

    <!-- Title -->
    <div class="mb-8 text-center">
      <h1 class="text-3xl sm:text-4xl font-bold">Booking Details</h1>
      <p class="text-gray-400 mt-1">Track and manage your reservation</p>
    </div>

    <!-- Refund Alert -->
    <% if (refundMsg) { %>
      <div id="refund-alert" class="mb-6">
        <div class="backdrop-blur-md bg-emerald-900/20 border border-emerald-500/20 rounded-xl p-4 text-center text-emerald-300 shadow-lg">
          <%= refundMsg %>
        </div>
      </div>
    <% } %>

    <!-- MAIN CARD -->
    <div class="bg-gray-800/60 backdrop-blur-xl rounded-2xl shadow-2xl p-6 sm:p-8 space-y-8 border border-white/10">

      <!-- Status -->
      <div class="text-right">
        <% if (booking.status === "Confirmed") { %>
          <span class="px-4 py-1.5 rounded-full bg-emerald-600/20 text-emerald-400">✔ Booking Confirmed</span>
        <% } else if (booking.status === "Pending") { %>
          <span class="px-4 py-1.5 rounded-full bg-yellow-600/20 text-yellow-400">⏳ Awaiting Confirmation</span>
        <% } else if (booking.status === "Cancelled") { %>
          <span class="px-4 py-1.5 rounded-full bg-red-600/20 text-red-400">❌ Cancelled</span>
        <% } else if (booking.status === "checkedIn") { %>
          <span class="px-4 py-1.5 rounded-full bg-blue-600/20 text-blue-400">🏨 Checked-In</span>
        <% } %>
      </div>

      <!-- Property -->
      <div class="grid md:grid-cols-3 gap-6">
        <img src="<%= booking.home.photoUrl %>"
             class="w-full h-56 object-cover rounded-xl border border-white/10"
             onerror="this.src='https://via.placeholder.com/400x300'"/>

        <div class="md:col-span-2 space-y-3">
          <h2 class="text-2xl font-bold"><%= booking.home.houseName %></h2>
          <p class="text-gray-400"><%= booking.home.location %></p>

          <div class="flex gap-4 text-gray-300 flex-wrap">
            <span>🛏 <%= booking.home.bedrooms %> Bedrooms</span>
            <span>👥 <%= booking.numberOfPeople %> Guests</span>
          </div>
        </div>
      </div>

      <!-- Dates -->
      <div class="grid sm:grid-cols-2 gap-5">
        <div class="bg-gray-700/60 rounded-xl p-4">
          <p class="text-gray-400 text-sm">Check-in</p>
          <p class="text-xl font-semibold mt-1"><%= booking.checkInDate.toDateString() %></p>
        </div>

        <div class="bg-gray-700/60 rounded-xl p-4">
          <p class="text-gray-400 text-sm">Check-out</p>
          <p class="text-xl font-semibold mt-1"><%= booking.checkOutDate.toDateString() %></p>
        </div>
      </div>

      <!-- Payment -->
      <div class="bg-gray-700/60 rounded-xl p-5 space-y-3">
        <div class="flex justify-between">
          <span>Total Price</span>
          <span class="font-semibold">₹<%= booking.totalPrice %></span>
        </div>

        <div class="flex justify-between items-center">
          <span>Payment Status</span>

          <% if (booking.paymentStatus === "Paid") { %>
            <span class="text-emerald-400 font-semibold">Paid</span>
          <% } else if (booking.paymentStatus === "Refunded") { %>
            <span class="text-yellow-400 font-semibold">Refunded</span>
          <% } else { %>
            <span class="text-red-400 font-semibold">Pending</span>
          <% } %>
        </div>

        <% if (booking.paymentStatus === "Pending") { %>
          <div class="text-center mt-3">
            <a href="/payment/<%= booking._id %>"
               class="inline-block px-6 py-2.5 rounded-lg font-semibold bg-emerald-600 hover:bg-emerald-700 transition">
              💳 Pay Now
            </a>
            <p class="text-gray-400 text-sm mt-2">or Pay at check-in</p>
          </div>
        <% } %>
      </div>

      <!-- Verification -->
      <% if (booking.status === "Confirmed") { %>
        <div class="bg-emerald-900/20 border border-emerald-600/30 rounded-xl p-6 space-y-4">
          <h3 class="text-xl font-bold text-emerald-400">Check-in Verification</h3>
          <p class="text-gray-300">Show OTP or QR code to host.</p>

          <div class="grid sm:grid-cols-2 gap-6">
            <div class="bg-gray-800 rounded-xl p-5 text-center">
              <p class="text-gray-400 text-sm">Your OTP</p>
              <p class="text-3xl font-bold tracking-wider mt-2"><%= booking.checkInOtp %></p>
            </div>

            <div class="text-center">
              <img src="<%= booking.qrcode %>" class="mx-auto w-44 rounded-lg border border-white/20"/>
              <p class="text-gray-400 text-sm mt-2">Scan at property</p>
            </div>
          </div>
        </div>
      <% } %>

      <!-- Cancel -->
      <% if (booking.status !== "Cancelled" && cancellable) { %>
        <div>
          <button
            onclick="openCancelModal('<%= booking._id %>', <%= refundable %>)"
            class="px-5 py-2.5 mt-4 rounded-full bg-red-600 hover:bg-red-700 font-semibold transition">
            Cancel Booking
          </button>

          <p class="text-sm mt-2 <%= refundable ? 'text-emerald-400' : 'text-gray-400' %>">
            <%= refundable
              ? '* Full refund if cancelled 48 hours before check-in'
              : '* No refund available for this booking' %>
          </p>
        </div>
      <% } %>

    </div>
  </div>
</div>

<!-- CANCEL MODAL -->
<div id="cancelModal" class="fixed inset-0 hidden z-50 items-center justify-center bg-black/60">
  <div class="bg-gray-900 rounded-2xl max-w-md w-full p-6 border border-white/10 shadow-2xl">
    <h3 class="text-xl font-bold text-red-400">Cancel Booking?</h3>

    <p class="text-gray-300 mt-2">
      Are you sure you want to cancel this booking?
    </p>

    <p id="modalRefundText" class="mt-3 text-sm font-medium"></p>

    <form id="cancelForm" method="POST" class="mt-4 space-y-4">
      <textarea
        name="reasonForCancellation"
        rows="3"
        required
        placeholder="Reason for cancellation..."
        class="w-full bg-white/10 border border-white/20 rounded-lg p-3"></textarea>

      <div class="flex justify-end gap-3">
        <button type="button"
                onclick="closeCancelModal()"
                class="px-4 py-2 rounded-lg bg-white/10 hover:bg-white/20">
          Keep Booking
        </button>

        <button type="submit"
                class="px-4 py-2 rounded-lg bg-red-600 hover:bg-red-700">
          Yes, Cancel
        </button>
      </div>
    </form>
  </div>
</div>

<script>
/* refund alert auto-hide */
const alertBox = document.getElementById("refund-alert");
if (alertBox) {
  setTimeout(() => {
    alertBox.style.opacity = "0";
    setTimeout(() => alertBox.remove(), 600);
  }, 5000);
}

/* cancel modal */
const modal = document.getElementById("cancelModal");
const refundText = document.getElementById("modalRefundText");
const cancelForm = document.getElementById("cancelForm");

function openCancelModal(id, refundable) {
  cancelForm.action = `/cancelBooking/${id}`;

  refundText.textContent = refundable
    ? "✔ Full refund will be processed after cancellation."
    : "✖ This booking is non-refundable.";

  refundText.className = refundable
    ? "mt-3 text-sm font-medium text-emerald-400"
    : "mt-3 text-sm font-medium text-red-400";

  modal.classList.remove("hidden");
  modal.classList.add("flex");
}

function closeCancelModal() {
  modal.classList.add("hidden");
  modal.classList.remove("flex");
}
</script>
