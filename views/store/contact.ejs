<%- include('../partials/header') %>
</head>
<body class="bg-gradient-to-br from-gray-900 via-gray-800 to-black min-h-screen scroll-smooth">
   <%- include('../partials/nav.ejs') %>
    
    <div class="container mx-auto px-3 sm:px-4 py-6 sm:py-12 pt-28 sm:pt-32">
        <!-- Header Section -->
        <div class="text-center space-y-3 sm:space-y-6 mb-12 sm:mb-16 max-w-3xl mx-auto">
            <div class="inline-block mb-4">
                <span class="px-4 py-2 rounded-full text-sm font-semibold backdrop-blur-md bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
                    Get in Touch
                </span>
            </div>
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white/90">
                Contact easyHome
            </h1>
            <p class="text-gray-400 text-sm sm:text-base md:text-lg leading-relaxed">
                Have questions about our platform? We're here to help! Reach out to our support team and we'll get back to you as soon as possible.
            </p>
        </div>

        <div class="max-w-6xl mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8 mb-12 sm:mb-16">
                <!-- Contact Info Cards -->
                
                <!-- Email Card -->
                <div class="backdrop-blur-md bg-white/5 border border-white/10 rounded-xl sm:rounded-2xl p-6 sm:p-8 hover:bg-white/[0.08] transition-all duration-300">
                    <div class="flex flex-col items-center text-center">
                        <div class="w-12 h-12 sm:w-16 sm:h-16 rounded-lg bg-blue-500/20 border border-blue-500/30 flex items-center justify-center mb-4">
                            <svg class="w-6 h-6 sm:w-8 sm:h-8 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                            </svg>
                        </div>
                        <h3 class="text-lg sm:text-xl font-bold text-white/90 mb-2">Email Us</h3>
                        <p class="text-gray-400 text-sm sm:text-base mb-4">
                            Our team responds within 24 hours
                        </p>
                        <a href="mailto:thisiseasyhome@gmail.com" class="text-blue-400 hover:text-blue-300 font-semibold transition-colors text-sm sm:text-base">
                            thisiseasyhome@gmail.com
                        </a>
                    </div>
                </div>

                <!-- Phone Card -->
                <div class="backdrop-blur-md bg-white/5 border border-white/10 rounded-xl sm:rounded-2xl p-6 sm:p-8 hover:bg-white/[0.08] transition-all duration-300">
                    <div class="flex flex-col items-center text-center">
                        <div class="w-12 h-12 sm:w-16 sm:h-16 rounded-lg bg-emerald-500/20 border border-emerald-500/30 flex items-center justify-center mb-4">
                            <svg class="w-6 h-6 sm:w-8 sm:h-8 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 00.948.684l1.498 7.492a1 1 0 00.502.756l2.048 1.029a11.042 11.042 0 005.516 5.516l1.029 2.048a1 1 0 00.756.502l7.492 1.498a1 1 0 00.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                            </svg>
                        </div>
                        <h3 class="text-lg sm:text-xl font-bold text-white/90 mb-2">Call Us</h3>
                        <p class="text-gray-400 text-sm sm:text-base mb-4">
                            Monday - Friday, 9 AM - 6 PM IST
                        </p>
                        <a href="tel:+919876543210" class="text-emerald-400 hover:text-emerald-300 font-semibold transition-colors text-sm sm:text-base">
                            +91 8630350659
                        </a>
                    </div>
                </div>

                <!-- Location Card -->
                <div class="backdrop-blur-md bg-white/5 border border-white/10 rounded-xl sm:rounded-2xl p-6 sm:p-8 hover:bg-white/[0.08] transition-all duration-300">
                    <div class="flex flex-col items-center text-center">
                        <div class="w-12 h-12 sm:w-16 sm:h-16 rounded-lg bg-purple-500/20 border border-purple-500/30 flex items-center justify-center mb-4">
                            <svg class="w-6 h-6 sm:w-8 sm:h-8 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                            </svg>
                        </div>
                        <h3 class="text-lg sm:text-xl font-bold text-white/90 mb-2">Visit Us</h3>
                        <p class="text-gray-400 text-sm sm:text-base mb-4">
                            Come by our office
                        </p>
                        <p class="text-purple-400 font-semibold text-sm sm:text-base">
                         Dehradun, Uttarakhand, India
                        </p>
                    </div>
                </div>
            </div>

            <!-- Contact Form Section -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 sm:gap-10">
                <!-- Form -->
                <div class="backdrop-blur-md bg-white/5 border border-white/10 rounded-xl sm:rounded-2xl p-6 sm:p-8">
                    <h2 class="text-2xl sm:text-3xl font-bold text-white/90 mb-6">Send us a Message</h2>
                    
                    <form class="space-y-5 sm:space-y-6">
                        <!-- Name Field -->
                        <div>
                            <label for="name" class="block text-sm font-semibold text-white/80 mb-2">
                                Full Name
                            </label>
                            <input 
                                type="text" 
                                id="name" 
                                name="name"
                                placeholder="John Doe"
                                class="w-full px-4 py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:border-blue-500/50 focus:bg-white/15 transition-all duration-300"
                                required
                            >
                        </div>

                        <!-- Email Field -->
                        <div>
                            <label for="email" class="block text-sm font-semibold text-white/80 mb-2">
                                Email Address
                            </label>
                            <input 
                                type="email" 
                                id="email" 
                                name="email"
                                placeholder="you@example.com"
                                class="w-full px-4 py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:border-blue-500/50 focus:bg-white/15 transition-all duration-300"
                                required
                            >
                        </div>

                        <!-- Subject Field -->
                        <div>
                            <label for="subject" class="block text-sm font-semibold text-white/80 mb-2">
                                Subject
                            </label>
                            <input 
                                type="text" 
                                id="subject" 
                                name="subject"
                                placeholder="How can we help?"
                                class="w-full px-4 py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:border-blue-500/50 focus:bg-white/15 transition-all duration-300"
                                required
                            >
                        </div>

                        <!-- Message Field -->
                        <div>
                            <label for="message" class="block text-sm font-semibold text-white/80 mb-2">
                                Message
                            </label>
                            <textarea 
                                id="message" 
                                name="message"
                                placeholder="Tell us more about your inquiry..."
                                rows="5"
                                class="w-full px-4 py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:border-blue-500/50 focus:bg-white/15 transition-all duration-300 resize-none"
                                required
                            ></textarea>
                        </div>

                        <!-- Submit Button -->
                        <button 
                            type="submit"
                            class="w-full px-6 py-3 rounded-lg text-white font-semibold text-center backdrop-blur-lg bg-gradient-to-r from-blue-600 to-blue-700 border border-blue-500/30 shadow-lg hover:shadow-blue-500/20 transition-all duration-300 hover:scale-[1.02]"
                        >
                            Send Message
                        </button>
                    </form>
                </div>

                <!-- Side Information -->
                <div class="space-y-6 sm:space-y-8">
                    <!-- Quick Response Card -->
                    <div class="backdrop-blur-md bg-gradient-to-br from-emerald-500/10 to-blue-500/10 border border-white/10 rounded-xl sm:rounded-2xl p-6 sm:p-8">
                        <div class="flex gap-4 mb-4">
                            <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-lg bg-emerald-500/20 border border-emerald-500/30 flex items-center justify-center flex-shrink-0">
                                <svg class="w-5 h-5 sm:w-6 sm:h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                                </svg>
                            </div>
                            <div>
                                <h3 class="text-lg font-bold text-white/90">Quick Response</h3>
                                <p class="text-gray-400 text-sm">We typically reply within 24 hours</p>
                            </div>
                        </div>
                    </div>

                    <!-- Available Support Card -->
                    <div class="backdrop-blur-md bg-gradient-to-br from-blue-500/10 to-purple-500/10 border border-white/10 rounded-xl sm:rounded-2xl p-6 sm:p-8">
                        <div class="flex gap-4 mb-4">
                            <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-lg bg-blue-500/20 border border-blue-500/30 flex items-center justify-center flex-shrink-0">
                                <svg class="w-5 h-5 sm:w-6 sm:h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.172l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>
                                </svg>
                            </div>
                            <div>
                                <h3 class="text-lg font-bold text-white/90">24/7 Support</h3>
                                <p class="text-gray-400 text-sm">Available round the clock for emergencies</p>
                            </div>
                        </div>
                    </div>

                    <!-- Expert Team Card -->
                    <div class="backdrop-blur-md bg-gradient-to-br from-purple-500/10 to-pink-500/10 border border-white/10 rounded-xl sm:rounded-2xl p-6 sm:p-8">
                        <div class="flex gap-4 mb-4">
                            <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-lg bg-purple-500/20 border border-purple-500/30 flex items-center justify-center flex-shrink-0">
                                <svg class="w-5 h-5 sm:w-6 sm:h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                            </div>
                            <div>
                                <h3 class="text-lg font-bold text-white/90">Expert Team</h3>
                                <p class="text-gray-400 text-sm">Knowledgeable staff ready to assist</p>
                            </div>
                        </div>
                    </div>

                    <!-- Social Links -->
                    <div class="backdrop-blur-md bg-white/5 border border-white/10 rounded-xl sm:rounded-2xl p-6 sm:p-8">
                        <h3 class="text-lg font-bold text-white/90 mb-4">Follow Us</h3>
                        <div class="flex gap-3">
                            
                            <a href="https://www.linkedin.com/in/dhruv-suyal-a7a68b29b" class="w-10 h-10 rounded-lg bg-blue-600/20 border border-blue-600/30 flex items-center justify-center hover:bg-blue-600/30 transition-all duration-300" title="LinkedIn" target="_blank">
                                <svg class="w-5 h-5 text-blue-500" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- FAQ Section -->
            <div class="mt-16 sm:mt-20">
                <h2 class="text-2xl sm:text-3xl font-bold text-white/90 mb-8 text-center">Frequently Asked Questions</h2>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="backdrop-blur-md bg-white/5 border border-white/10 rounded-xl p-6 hover:bg-white/[0.08] transition-all duration-300">
                        <h3 class="text-lg font-bold text-white/90 mb-3">How do I book a property?</h3>
                        <p class="text-gray-400 text-sm leading-relaxed">
                            Simply browse our available properties, select your dates, and complete the booking process. You'll receive a confirmation email with all the details.
                        </p>
                    </div>

                    <div class="backdrop-blur-md bg-white/5 border border-white/10 rounded-xl p-6 hover:bg-white/[0.08] transition-all duration-300">
                        <h3 class="text-lg font-bold text-white/90 mb-3">What's your cancellation policy?</h3>
                        <p class="text-gray-400 text-sm leading-relaxed">
                            Cancellation policies vary by property. Check the specific property listing for details on refunds and cancellation terms.
                        </p>
                    </div>

                    <div class="backdrop-blur-md bg-white/5 border border-white/10 rounded-xl p-6 hover:bg-white/[0.08] transition-all duration-300">
                        <h3 class="text-lg font-bold text-white/90 mb-3">Is my payment secure?</h3>
                        <p class="text-gray-400 text-sm leading-relaxed">
                            Yes, we use industry-standard encryption to protect your payment information. All transactions are secure and verified.
                        </p>
                    </div>

                    <div class="backdrop-blur-md bg-white/5 border border-white/10 rounded-xl p-6 hover:bg-white/[0.08] transition-all duration-300">
                        <h3 class="text-lg font-bold text-white/90 mb-3">How can I list my property?</h3>
                        <p class="text-gray-400 text-sm leading-relaxed">
                            Contact our support team to learn about becoming a host. We'll guide you through the verification and listing process.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <%- include('../partials/footer') %>
</body>
</html>
