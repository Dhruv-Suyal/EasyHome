<%- include('../partials/header') %>
</head>
<body class="bg-gradient-to-br from-gray-900 via-gray-800 to-black min-h-screen">
   <%- include('../partials/nav.ejs') %>
    
    <div class="container mx-auto px-4 py-12 pt-28">
        <div class="text-center space-y-4 mb-16">
            <h1 class="text-4xl font-bold text-white/90">
                My Favourites
            </h1>
            <p class="text-gray-400 max-w-2xl mx-auto">
                Your saved properties for future reference
            </p>
        </div>

        <!-- Desktop & Tablet Grid -->
        <div class="hidden sm:grid grid-cols-1 md:grid-cols-2 gap-8 max-w-7xl mx-auto">
            <% favourites.forEach((Home)=>{ %>
                <div class="backdrop-blur-md bg-white/10 border border-white/20 rounded-2xl overflow-hidden shadow-xl transition-all duration-300 hover:scale-[1.02] hover:shadow-2xl group">
                    <div class="relative aspect-video overflow-hidden">
                        <img 
                            src="<%= Home.photoUrl %>" 
                            alt="<%=Home.houseName%>"
                            class="object-cover w-full h-full transform group-hover:scale-110 transition-transform duration-700"
                        >
                        <div class="absolute top-4 right-4">
                            <span class="px-4 py-2 rounded-full text-sm backdrop-blur-md bg-black/50 text-white/90 border border-white/10">
                                ₹<%= Home.price %> per night
                            </span>
                        </div>
                    </div>

                    <div class="p-8 space-y-6">
                        <div class="space-y-2">
                            <h2 class="text-2xl font-bold text-white/90"><%=Home.houseName%></h2>
                            <div class="flex items-center text-white/70">
                                <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"/>
                                </svg>
                                <%= Home.location %>
                            </div>
                            <p class="text-gray-400 text-sm mt-2">
                                Experience luxury living in this stunning property with modern amenities and breathtaking views.
                            </p>
                        </div>

                        <div class="flex items-center justify-between gap-4 pt-6 border-t border-white/10">
                            <a href="/booking/<%= Home._id %>" class="flex-1 px-4 py-3 rounded-lg text-white font-medium text-center backdrop-blur-lg bg-emerald-600/80 border border-emerald-500/30 shadow-lg transition-all duration-300 hover:scale-105 hover:bg-emerald-600">
                                Book Now
                            </a>
                            <form action="/store/favourites/<%= Home._id %>" method="POST" class="flex-1">
                                <button type="submit" class="w-full px-4 py-3 rounded-lg text-white font-medium backdrop-blur-lg bg-red-600/80 border border-red-500/30 shadow-lg transition-all duration-300 hover:scale-105 hover:bg-red-600">
                                    Remove
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>

        <!-- Mobile Grid (Clean & Minimal) -->
        <div class="sm:hidden grid grid-cols-2 gap-2 sm:gap-4 max-w-7xl mx-auto">
            <% favourites.forEach((Home)=>{ %>
                <a href="/booking/<%= Home._id %>" class="backdrop-blur-md bg-white/10 border border-white/20 rounded-lg overflow-hidden shadow-lg transition-all duration-300 hover:shadow-xl hover:bg-white/15 group">
                    <!-- Image Container -->
                    <div class="relative w-full h-40 overflow-hidden">
                        <img 
                            src="<%= Home.photoUrl %>" 
                            alt="<%=Home.houseName%>"
                            class="object-cover w-full h-full transform group-hover:scale-110 transition-transform duration-700"
                        >
                        <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
                        
                        <!-- Price Badge -->
                        <div class="absolute bottom-3 right-3">
                            <span class="px-3 py-1.5 rounded-full text-xs font-semibold backdrop-blur-md bg-black/60 text-white/90 border border-white/10">
                                ₹<%= Home.price %>
                            </span>
                        </div>
                    </div>

                    <!-- Info Container -->
                    <div class="p-4 space-y-2.5">
                        <div class="space-y-1.5">
                            <h2 class="text-base font-bold text-white/90 line-clamp-1"><%=Home.houseName%></h2>
                            
                            <div class="flex items-center text-white/70 text-xs gap-1">
                                <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"/>
                                </svg>
                                <span class="line-clamp-1"><%= Home.location %></span>
                            </div>
                        </div>

                        <!-- CTA Button -->
                        <div class="pt-2 flex gap-2">
                            <div class="flex-1 px-3 py-2 rounded-md text-white font-medium text-center text-xs backdrop-blur-lg bg-emerald-600/80 border border-emerald-500/30 transition-all duration-300">
                                Book
                            </div>
                            <form action="/store/favourites/<%= Home._id %>" method="POST" class="flex-1">
                                <button type="submit" class="w-full px-3 py-2 rounded-md text-white font-medium text-xs backdrop-blur-lg bg-red-600/80 border border-red-500/30 transition-all duration-300">
                                    Remove
                                </button>
                            </form>
                        </div>
                    </div>
                </a>
            <% }) %>
        </div>

        <% if (favourites.length === 0) { %>
            <div class="text-center py-16">
                <p class="text-gray-400 text-xl">No favourite properties yet. Start adding your favorites!</p>
            </div>
        <% } %>
    </div>
    <%- include('../partials/footer') %>
</body>
</html>