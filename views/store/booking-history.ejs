<%- include('../partials/header') %>
</head>
<body class="bg-gradient-to-br from-gray-950 via-gray-900 to-black text-white">
<%- include('../partials/nav') %>
<!-- PAGE WRAPPER -->
<section class="max-w-7xl mx-auto px-4 py-10 pt-20">

    <!-- PAGE TITLE -->
    <h1 class="text-3xl font-bold mb-10 flex items-center gap-2">
        📖 Booking History
    </h1>

    <!-- TWO BLOCK LAYOUT -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

        <!-- ✅ COMPLETED BOOKINGS -->
        <div class="bg-green-500/10 border border-green-500/30 rounded-xl p-6">
            <h2 class="text-xl font-semibold text-green-400 mb-6">
                ✅ Completed Bookings
            </h2>
            <% booking.forEach((booking)=>{ %>
                <% if(booking.status === 'Completed'){ %>
            <!-- CARD -->
            <div class="space-y-4">
                <div class="bg-black/40 rounded-lg p-5 border border-white/10 hover:shadow-lg transition">
                    <h3 class="text-lg font-semibold">
                       <%= booking.home.houseName %>
                    </h3>
                    <p class="text-gray-400 text-sm">
                        <%= booking.home.location %>
                    </p>

                    <div class="mt-3 text-sm text-gray-300 space-y-1">
                        <p>Check-in: <%= booking.home.checkInDate %></p>
                        <p>Check-out:<%= booking.home.checkOutDate %></p>
                        <p>Total: <%= booking.totalPrice %></p>
                    </div>

                    <span class="inline-block mt-4 px-3 py-1 text-xs rounded-full bg-green-500/20 text-green-400">
                        <%= booking.status %>
                    </span>
                </div>
                <% } %>
            <% }) %>
            </div>
        <!-- ❌ CANCELLED BOOKINGS -->
         
        <div class="bg-red-500/10 border border-red-500/30 rounded-xl p-6">
            <h2 class="text-xl font-semibold text-red-400 mb-6">
                ❌ Cancelled Bookings
            </h2>
            <% booking.forEach((booking)=>{ %>
                <% if(booking.status === 'Cancelled'){ %>
            <div class="space-y-4">
                <div class="bg-black/40 rounded-lg p-5 border border-white/10">
                    <h3 class="text-lg font-semibold">
                          <%= booking.home.houseName %>
                    </h3>
                    <p class="text-gray-400 text-sm">
                        <%= booking.home.location %>
                    </p>

                    <div class="mt-3 text-sm text-gray-300 space-y-1">
                        <p>Check-in: <%= booking.checkInDate %></p>
                        <p>Check-out: <%= booking.checkOutDate %></p>
                        <p>Total: <%= booking.totalPrice%></p>
                    </div>

                    <span class="inline-block mt-4 px-3 py-1 text-xs rounded-full bg-red-500/20 text-red-400">
                        <%= booking.status %>
                    </span>
                </div>
            </div>
            <% } %>
            <% })%>

        </div>

    </div>
</section>
<%- include('../partials/footer') %>

</body>
</html>
