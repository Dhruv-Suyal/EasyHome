<%- include('../partials/header') %>
</head>
<body class="bg-gradient-to-br from-gray-900 via-gray-800 to-black min-h-screen scroll-smooth">
   <%- include('../partials/nav.ejs') %>
    
    <div class="container mx-auto px-3 sm:px-4 py-6 sm:py-12 pt-28 sm:pt-32">
        <!-- Header Section -->
        <div class="text-center space-y-3 sm:space-y-6 mb-12 sm:mb-16 max-w-3xl mx-auto">
            <div class="inline-block mb-4">
                <span class="px-4 py-2 rounded-full text-sm font-semibold backdrop-blur-md bg-red-500/20 text-red-400 border border-red-500/30">
                    Your Safety Matters
                </span>
            </div>
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white/90">
                Safety Tips
            </h1>
            <p class="text-gray-400 text-sm sm:text-base md:text-lg leading-relaxed">
                Essential guidelines to ensure a safe and secure experience on easyHome
            </p>
        </div>

        <!-- Main Content -->
        <div class="max-w-3xl mx-auto space-y-6 sm:space-y-8">

            <!-- Before Your Arrival -->
            <div class="backdrop-blur-md bg-white/5 border border-white/10 rounded-xl p-6 sm:p-8">
                <h2 class="text-xl sm:text-2xl font-bold text-white/90 mb-6 flex items-center gap-3">
                    <span class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-500/20 border border-blue-500/30 flex items-center justify-center">
                        <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </span>
                    Before Your Arrival
                </h2>
                <ul class="space-y-3 text-gray-400 text-sm sm:text-base">
                    <li class="flex gap-3">
                        <span class="text-blue-400 font-bold flex-shrink-0">✓</span>
                        <span>Read the property listing carefully and check for any important house rules or restrictions</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="text-blue-400 font-bold flex-shrink-0">✓</span>
                        <span>Review all amenities, directions, and check-in instructions provided by the host</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="text-blue-400 font-bold flex-shrink-0">✓</span>
                        <span>Verify the host's reviews and rating before confirming your booking</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="text-blue-400 font-bold flex-shrink-0">✓</span>
                        <span>Communicate with the host through easyHome to clarify any doubts about the property</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="text-blue-400 font-bold flex-shrink-0">✓</span>
                        <span>Share your booking details with a trusted friend or family member</span>
                    </li>
                </ul>
            </div>

            <!-- During Check-in -->
            <div class="backdrop-blur-md bg-white/5 border border-white/10 rounded-xl p-6 sm:p-8">
                <h2 class="text-xl sm:text-2xl font-bold text-white/90 mb-6 flex items-center gap-3">
                    <span class="flex-shrink-0 w-8 h-8 rounded-full bg-green-500/20 border border-green-500/30 flex items-center justify-center">
                        <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                        </svg>
                    </span>
                    During Check-in
                </h2>
                <ul class="space-y-3 text-gray-400 text-sm sm:text-base">
                    <li class="flex gap-3">
                        <span class="text-green-400 font-bold flex-shrink-0">✓</span>
                        <span>Inspect the property for any damages and take photos before unpacking</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="text-green-400 font-bold flex-shrink-0">✓</span>
                        <span>Locate emergency exits, first aid kits, and emergency contact information</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="text-green-400 font-bold flex-shrink-0">✓</span>
                        <span>Test locks, windows, and security features to ensure they work properly</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="text-green-400 font-bold flex-shrink-0">✓</span>
                        <span>Make note of local emergency numbers and nearby hospitals or police stations</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="text-green-400 font-bold flex-shrink-0">✓</span>
                        <span>Introduce yourself to the host and confirm emergency contact procedures</span>
                    </li>
                </ul>
            </div>

            <!-- During Your Stay -->
            <div class="backdrop-blur-md bg-white/5 border border-white/10 rounded-xl p-6 sm:p-8">
                <h2 class="text-xl sm:text-2xl font-bold text-white/90 mb-6 flex items-center gap-3">
                    <span class="flex-shrink-0 w-8 h-8 rounded-full bg-purple-500/20 border border-purple-500/30 flex items-center justify-center">
                        <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
                        </svg>
                    </span>
                    During Your Stay
                </h2>
                <ul class="space-y-3 text-gray-400 text-sm sm:text-base">
                    <li class="flex gap-3">
                        <span class="text-purple-400 font-bold flex-shrink-0">✓</span>
                        <span>Always lock doors and windows when leaving the property or going to sleep</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="text-purple-400 font-bold flex-shrink-0">✓</span>
                        <span>Do not share your keycard or access codes with anyone outside your group</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="text-purple-400 font-bold flex-shrink-0">✓</span>
                        <span>Keep valuables in a safe place or use the property's safe if available</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="text-purple-400 font-bold flex-shrink-0">✓</span>
                        <span>Be aware of your surroundings when entering/exiting the property</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="text-purple-400 font-bold flex-shrink-0">✓</span>
                        <span>Follow all house rules and respect the property and its facilities</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="text-purple-400 font-bold flex-shrink-0">✓</span>
                        <span>Report any suspicious activity or safety concerns to the host immediately</span>
                    </li>
                </ul>
            </div>

            <!-- Personal Safety -->
            <div class="backdrop-blur-md bg-white/5 border border-white/10 rounded-xl p-6 sm:p-8">
                <h2 class="text-xl sm:text-2xl font-bold text-white/90 mb-6 flex items-center gap-3">
                    <span class="flex-shrink-0 w-8 h-8 rounded-full bg-cyan-500/20 border border-cyan-500/30 flex items-center justify-center">
                        <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </span>
                    Personal Safety
                </h2>
                <ul class="space-y-3 text-gray-400 text-sm sm:text-base">
                    <li class="flex gap-3">
                        <span class="text-cyan-400 font-bold flex-shrink-0">✓</span>
                        <span>Avoid sharing personal information with other guests or strangers you meet</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="text-cyan-400 font-bold flex-shrink-0">✓</span>
                        <span>Be cautious when exploring unfamiliar neighborhoods, especially at night</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="text-cyan-400 font-bold flex-shrink-0">✓</span>
                        <span>Keep your phone charged and save emergency contacts before your trip</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="text-cyan-400 font-bold flex-shrink-0">✓</span>
                        <span>Travel in groups when possible and inform someone of your plans</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="text-cyan-400 font-bold flex-shrink-0">✓</span>
                        <span>Trust your instincts - if something feels wrong, remove yourself from the situation</span>
                    </li>
                </ul>
            </div>

            <!-- Internet & Payment Safety -->
            <div class="backdrop-blur-md bg-white/5 border border-white/10 rounded-xl p-6 sm:p-8">
                <h2 class="text-xl sm:text-2xl font-bold text-white/90 mb-6 flex items-center gap-3">
                    <span class="flex-shrink-0 w-8 h-8 rounded-full bg-orange-500/20 border border-orange-500/30 flex items-center justify-center">
                        <svg class="w-5 h-5 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                        </svg>
                    </span>
                    Internet & Payment Safety
                </h2>
                <ul class="space-y-3 text-gray-400 text-sm sm:text-base">
                    <li class="flex gap-3">
                        <span class="text-orange-400 font-bold flex-shrink-0">✓</span>
                        <span>Only use easyHome's secure payment system - never transfer money directly to hosts</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="text-orange-400 font-bold flex-shrink-0">✓</span>
                        <span>Use secure WiFi networks and avoid conducting sensitive transactions on public WiFi</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="text-orange-400 font-bold flex-shrink-0">✓</span>
                        <span>Never share your login credentials or two-factor authentication codes</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="text-orange-400 font-bold flex-shrink-0">✓</span>
                        <span>Report any suspicious activity or unauthorized charges immediately</span>
                    </li>
                </ul>
            </div>

            <!-- Checkout & After Stay -->
            <div class="backdrop-blur-md bg-white/5 border border-white/10 rounded-xl p-6 sm:p-8">
                <h2 class="text-xl sm:text-2xl font-bold text-white/90 mb-6 flex items-center gap-3">
                    <span class="flex-shrink-0 w-8 h-8 rounded-full bg-pink-500/20 border border-pink-500/30 flex items-center justify-center">
                        <svg class="w-5 h-5 text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                        </svg>
                    </span>
                    Checkout & After Stay
                </h2>
                <ul class="space-y-3 text-gray-400 text-sm sm:text-base">
                    <li class="flex gap-3">
                        <span class="text-pink-400 font-bold flex-shrink-0">✓</span>
                        <span>Do a final walkthrough and document the property condition with photos</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="text-pink-400 font-bold flex-shrink-0">✓</span>
                        <span>Return all keys and access cards before leaving the property</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="text-pink-400 font-bold flex-shrink-0">✓</span>
                        <span>Leave the property clean and in good condition as per house rules</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="text-pink-400 font-bold flex-shrink-0">✓</span>
                        <span>Leave honest reviews and feedback about your experience</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="text-pink-400 font-bold flex-shrink-0">✓</span>
                        <span>Report any incidents or issues to easyHome support immediately</span>
                    </li>
                </ul>
            </div>

            <!-- Emergency Contact -->
            <div class="backdrop-blur-md bg-gradient-to-r from-red-500/10 to-orange-500/10 border border-red-500/30 rounded-xl p-6 sm:p-8">
                <h2 class="text-xl sm:text-2xl font-bold text-white/90 mb-4 flex items-center gap-3">
                    <svg class="w-6 h-6 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                    </svg>
                    Emergency Contacts
                </h2>
                <p class="text-gray-400 text-sm sm:text-base mb-4">
                    In case of emergency, immediately contact:
                </p>
                <div class="space-y-2 text-gray-300 text-sm sm:text-base">
                    <p class="flex items-center gap-2">
                        <span class="text-red-400 font-bold">•</span>
                        <span><strong>Local Police:</strong> Dial 100 (India)</span>
                    </p>
                    <p class="flex items-center gap-2">
                        <span class="text-red-400 font-bold">•</span>
                        <span><strong>Medical Emergency:</strong> Dial 102 or your local ambulance service</span>
                    </p>
                    <p class="flex items-center gap-2">
                        <span class="text-red-400 font-bold">•</span>
                        <span><strong>easyHome Support:</strong> Contact us immediately for assistance</span>
                    </p>
                </div>
            </div>

        </div>
    </div>

    <%- include('../partials/footer') %>
</body>
</html>
