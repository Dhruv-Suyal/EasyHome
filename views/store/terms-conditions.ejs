            </div>

            <!-- Contact Section -->
            <div class="mt-12 sm:mt-16 p-6 sm:p-8 backdrop-blur-md bg-gradient-to-r from-blue-500/10 to-purple-500/10 border border-white/10 rounded-xl sm:rounded-2xl">
                <h3 class="text-xl sm:text-2xl font-bold text-white/90 mb-4">Questions about our Terms?</h3>
                <p class="text-gray-400 text-sm sm:text-base mb-6">
                    If you have any questions or concerns about these Terms & Conditions, please don't hesitate to contact our support team.
                </p>
                <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
                    <a href="/contact" class="px-6 py-3 rounded-lg text-white font-medium text-center backdrop-blur-lg bg-blue-600/80 border border-blue-500/30 hover:bg-blue-600/90 transition-all duration-300">
