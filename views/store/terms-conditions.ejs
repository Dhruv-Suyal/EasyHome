                                <li class="flex gap-3">
                                    <span class="text-purple-400 flex-shrink-0">•</span>
                                    <span>Cancellation policies are determined by individual property hosts</span>
                                </li>
                                <li class="flex gap-3">
                                    <span class="text-purple-400 flex-shrink-0">•</span>
                                    <span>Payment must be completed before reservation confirmation</span>
                                </li>
                                <li class="flex gap-3">
                                    <span class="text-purple-400 flex-shrink-0">•</span>
                                    <span>Check-in and check-out times are set by property hosts</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- 4. Payment and Fees -->
                <div class="backdrop-blur-md bg-white/5 border border-white/10 rounded-xl sm:rounded-2xl p-6 sm:p-8 hover:bg-white/[0.08] transition-all duration-300">
                    <div class="flex gap-4 sm:gap-6">
                        <div class="flex-shrink-0">
