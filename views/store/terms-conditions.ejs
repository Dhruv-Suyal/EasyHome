                                <span class="text-lg sm:text-xl font-bold text-purple-400">3</span>
                            </div>
                        </div>
                        <div class="flex-1">
                            <h2 class="text-xl sm:text-2xl font-bold text-white/90 mb-3">Booking and Reservations</h2>
                            <ul class="text-gray-400 text-sm sm:text-base space-y-2 leading-relaxed">
                                <li class="flex gap-3">
                                    <span class="text-purple-400 flex-shrink-0">•</span>
                                    <span>All bookings are subject to availability and confirmation by property hosts</span>
