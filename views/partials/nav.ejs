<script>
    function openMobileMenu() {
        const overlay = document.getElementById('mobile-menu-overlay');
        overlay.classList.remove('hidden');
        document.documentElement.style.overflow = 'hidden';
        document.body.style.overflow = 'hidden';
    }

    function closeMobileMenu() {
        const overlay = document.getElementById('mobile-menu-overlay');
        overlay.classList.add('hidden');
        document.documentElement.style.overflow = 'auto';
        document.body.style.overflow = 'auto';
    }

    // Close menu when clicking on overlay background
    document.getElementById('mobile-menu-overlay')?.addEventListener('click', function(e) {
        if (e.target === this) {
            closeMobileMenu();
        }
    });

    function toggleDesktopProfileMenu() {
        const menu = document.getElementById('desktop-profile-menu');
        const backdrop = document.getElementById('desktop-backdrop');
        if (menu && backdrop) {
            const isHidden = menu.classList.contains('hidden');
            menu.classList.toggle('hidden');
            backdrop.classList.toggle('hidden', !isHidden);
        }
    }

    // Close menus when clicking outside on desktop
    document.addEventListener('click', function(event) {
        const desktopMenu = document.getElementById('desktop-profile-menu');
        const desktopBackdrop = document.getElementById('desktop-backdrop');
        
        if (desktopMenu && !event.target.closest('button[onclick="toggleDesktopProfileMenu()"]') && !desktopMenu.contains(event.target)) {
            desktopMenu.classList.add('hidden');
            desktopBackdrop?.classList.add('hidden');
        }
    });
</script>
