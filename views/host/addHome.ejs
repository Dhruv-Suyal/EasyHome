<%- include('../partials/header') %>
</head>
<body class="bg-gradient-to-br from-gray-900 via-gray-800 to-black min-h-screen scroll-smooth">
   <%- include('../partials/nav') %>
   
   <div class="container mx-auto px-3 sm:px-4 py-6 sm:py-12">
        <div class="max-w-2xl mx-auto">
            <div class="backdrop-blur-md bg-white/10 border border-white/20 rounded-xl sm:rounded-2xl overflow-hidden shadow-xl p-4 sm:p-6 md:p-8">
                <!-- Header Section -->
                <div class="text-center mb-6 sm:mb-8 space-y-2 sm:space-y-4">
                    <h1 class="text-2xl sm:text-3xl font-bold text-white/90">
                        <%= editing ? 'Edit' : 'Register' %> your home
                    </h1>
                    <p class="text-gray-400 text-sm sm:text-base">Fill in the details below to list your property</p>
                </div>

                <%- include('../partials/errors') %>

                <!-- Form Section -->
                <form action="/host/<%= editing ? 'edit-home' : 'add-home' %>" method="POST" enctype="multipart/form-data" class="space-y-4 sm:space-y-6">
                    <input type="hidden" value="<%= editing ? Home._id: '' %>" name="id">
                    
                    <!-- Home Name Input -->
                    <div class="space-y-2">
                        <label for="homeName" class="block text-xs sm:text-sm font-medium text-white/70">Home Name</label>
                        <input 
                            id="homeName"
                            type="text" 
                            name="homeName" 
                            value="<%= editing || change ? Home.houseName : ''%>"
                            placeholder="Enter your home name"
                            class="w-full px-3 sm:px-4 py-2.5 sm:py-3 rounded-lg text-sm sm:text-base backdrop-blur-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all duration-300"
                            required
                        >
                    </div>

                    <!-- Location Input -->
                    <div class="space-y-2">
                        <label for="location" class="block text-xs sm:text-sm font-medium text-white/70">Location</label>
                        <input 
                            id="location"
                            type="text" 
                            name="location" 
                            value="<%= editing || change ? Home.location : ''%>"
                            placeholder="Enter your home location"
                            class="w-full px-3 sm:px-4 py-2.5 sm:py-3 rounded-lg text-sm sm:text-base backdrop-blur-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all duration-300"
                            required
                        >
                    </div>

                    <!-- Description Input -->
                    <div class="space-y-2">
                        <label for="description" class="block text-xs sm:text-sm font-medium text-white/70">Description</label>
                        <textarea 
                            id="description"
                            name="description" 
                            placeholder="Describe your property and its unique features"
                            rows="3"
                            class="w-full px-3 sm:px-4 py-2.5 sm:py-3 rounded-lg text-sm sm:text-base backdrop-blur-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all duration-300 resize-none"
                        ><%= editing || change ? Home.description : ''%></textarea>
                    </div>

                    <!-- Price Input -->
                    <div class="space-y-2">
                        <label for="price" class="block text-xs sm:text-sm font-medium text-white/70">Price per night</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-3 sm:pl-4 text-white/50">₹</span>
                            <input 
                                id="price"
                                type="number" 
                                name="pricePerNight" 
                                value="<%= editing || change ? Home.price : ''%>"
                                placeholder="0"
                                class="w-full pl-7 sm:pl-8 pr-3 sm:pr-4 py-2.5 sm:py-3 rounded-lg text-sm sm:text-base backdrop-blur-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all duration-300"
                                required
                            >
                        </div>
                    </div>

                    <!-- Property Details Grid -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4">
                        <!-- Bedrooms -->
                        <div class="space-y-2">
                            <label for="bedrooms" class="block text-xs sm:text-sm font-medium text-white/70">Bedrooms</label>
                            <input 
                                id="bedrooms"
                                type="number" 
                                name="bedrooms" 
                                value="<%= editing || change ? Home.bedrooms : ''%>"
                                placeholder="3"
                                class="w-full px-3 sm:px-4 py-2.5 sm:py-3 rounded-lg text-sm sm:text-base backdrop-blur-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all duration-300"
                                required
                            >
                        </div>

                        <!-- Bathrooms -->
                        <div class="space-y-2">
                            <label for="bathrooms" class="block text-xs sm:text-sm font-medium text-white/70">Bathrooms</label>
                            <input 
                                id="bathrooms"
                                type="number" 
                                name="bathrooms" 
                                value="<%= editing || change ? Home.bathrooms : ''%>"
                                placeholder="2"
                                class="w-full px-3 sm:px-4 py-2.5 sm:py-3 rounded-lg text-sm sm:text-base backdrop-blur-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all duration-300"
                                required
                            >
                        </div>

                        <!-- Square Feet -->
                        <div class="space-y-2">
                            <label for="squareFt" class="block text-xs sm:text-sm font-medium text-white/70">Sq. Ft.</label>
                            <input 
                                id="squareFt"
                                type="number" 
                                name="squareFt" 
                                value="<%= editing || change ? Home.squareFt : ''%>"
                                placeholder="1200"
                                class="w-full px-3 sm:px-4 py-2.5 sm:py-3 rounded-lg text-sm sm:text-base backdrop-blur-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all duration-300"
                                required
                            >
                        </div>
                    </div>

                    <!-- File Upload -->
                    <div class="space-y-2">
                        <label for="photoUrl" class="block text-xs sm:text-sm font-medium text-white/70">Property Photo</label>
                        <div class="mt-1 flex justify-center px-3 sm:px-6 pt-4 sm:pt-5 pb-4 sm:pb-6 border-2 border-white/20 border-dashed rounded-lg hover:border-white/30 transition-colors">
                            <div class="space-y-1 sm:space-y-2 text-center">
                                <svg class="mx-auto h-10 w-10 sm:h-12 sm:w-12 text-white/40" stroke="currentColor" fill="none" viewBox="0 0 48 48">
                                    <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                <div class="flex text-xs sm:text-sm text-white/70 justify-center">
                                    <label for="photoUrl" class="relative cursor-pointer bg-transparent rounded-md font-medium text-blue-400 hover:text-blue-300 focus-within:outline-none">
                                        <span>Upload a file</span>
                                        <input id="photoUrl" name="photoUrl" type="file" class="sr-only" accept="image/*">
                                    </label>
                                </div>
                                <p class="text-xs text-white/50">PNG, JPG up to 10MB</p>
                            </div>
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <button 
                        type="submit"
                        class="w-full py-2.5 sm:py-3 px-3 sm:px-4 rounded-lg text-sm sm:text-base text-white font-medium backdrop-blur-lg bg-blue-600/80 border border-blue-500/30 shadow-lg transition-all duration-300 hover:scale-105 hover:bg-blue-600"
                    >
                        <%= editing ? 'Update Property' : 'List Property' %>
                    </button>
                </form>
            </div>
        </div>
   </div>
</body>
</html>