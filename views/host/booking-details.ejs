<%- include('../partials/header') %>

<style>
#scannerOverlay{
  position: fixed;
  inset: 0;
  background: #000;
  z-index: 9999;
}

/* Reader must have size */
#reader{
  width: 100vw;
  height: 100vh;
  position: relative;
}

/* Force camera to actually show */
#reader video{
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important;
  display: block !important;
}

/* visible centered guide box */
.qr-box{
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 420px;
  height: 420px;
  border: 4px solid #00ffa6;
  border-radius: 18px;
  box-shadow:
    0 0 20px rgba(0,255,166,.6),
    inset 0 0 30px rgba(0,255,166,.3);
}

/* MOBILE responsive size */
@media(max-width: 768px){
  .qr-box{
    width: 280px;
    height: 280px;
  }
}

/* close button */
.close-btn{
  position:absolute;
  top:15px;
  right:15px;
  padding:10px 16px;
  background:red;
  color:white;
  border-radius:10px;
  font-weight: bold;
}

/* safe zone for notched phones */
body{
  padding-bottom: env(safe-area-inset-bottom);
}


/* ======================= */
/*     TOAST NOTIFICATION   */
/* ======================= */

.toast{
  position: fixed;
  top: 22px;
  right: 22px;
  min-width: 260px;
  max-width: 360px;
  padding: 14px 18px;
  border-radius: 14px;
  color: white;
  z-index: 10000;
  display: flex;
  gap: 10px;
  box-shadow: 0 10px 40px rgba(0,0,0,.45);
  backdrop-filter: blur(18px);
  transform: translateY(-25px);
  opacity: 0;
  pointer-events: none;
  transition: .35s ease;
}

.toast.show{
  transform: translateY(0);
  opacity: 1;
  pointer-events: auto;
}

.toast.success{
  background: linear-gradient(135deg,#0f5132,#198754);
  border: 1px solid #6ed2a2;
}

.toast.error{
  background: linear-gradient(135deg,#58151c,#842029);
  border: 1px solid #ff8da1;
}

.toast-icon{
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: rgba(255,255,255,.15);
  display: grid;
  place-items: center;
  font-size: 18px;
}


/* ======================= */
/*     LOADER OVERLAY       */
/* ======================= */

#loaderBox{
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.65);
  backdrop-filter: blur(6px);
  z-index: 9999;
  display: none;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.loader{
  width: 55px;
  height: 55px;
  border-radius: 50%;
  border: 5px solid transparent;
  border-top: 5px solid #00ffa6;
  animation: spin 1s linear infinite;
}

@keyframes spin{
  to{ transform: rotate(360deg) }
}


/* ======================= */
/*  SUCCESS FULLSCREEN POP  */
/* ======================= */

.success-frame{
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, .75);
  backdrop-filter: blur(8px);
  z-index: 9999;
  display: none;
  place-items: center;
}

.success-frame::after{
  content:"Verified Successfully 🎉";
  color:white;
  font-size: 28px;
  font-weight: bold;
  padding: 22px 32px;
  border: 2px solid #00ffa6;
  border-radius: 20px;

  box-shadow:
    0 0 18px rgba(0,255,166,.8),
    inset 0 0 30px rgba(0,255,166,.35);

  animation: pop .4s ease;
}

@keyframes pop{
  from{ transform: scale(.7); opacity: 0 }
  to{ transform: scale(1); opacity: 1 }
}

</style>

</head>

<body class="bg-gradient-to-br from-gray-900 via-gray-800 to-black min-h-screen">

<%- include('../partials/nav') %>

<div class="container mx-auto px-3 sm:px-6 pt-28 pb-20 max-w-3xl">

    <h1 class="text-3xl font-bold text-white text-center">Booking Verification</h1>
    <p class="text-gray-400 text-center mb-6">Verify guest using OTP or QR scan</p>

    <% if(otpMsg){ %>
        <div class="max-w-3xl mx-auto mt-4 mb-3">
            <div class="px-5 py-3 rounded-2xl border shadow-xl backdrop-blur-xl
              bg-gradient-to-r from-emerald-600/20 to-emerald-400/10
              border-emerald-400/40 text-emerald-300
              flex items-center gap-3">
                <span class="text-xl">✔</span>
                <p class="font-semibold tracking-wide"><%= otpMsg %></p>
            </div>
        </div>
    <% } %>
    <!-- CARD -->
    <div class="bg-white/10 backdrop-blur-xl rounded-2xl border border-white/20 shadow-xl overflow-hidden">
        <div class="relative">

    <img src="<%= booking.home.photoUrl %>" class="w-full h-56 object-cover">

    <span class="absolute top-4 right-4 px-4 py-2 rounded-xl text-sm font-semibold
        <% if(booking.status === 'confirmed'){ %>
            bg-emerald-600/80 text-white border border-emerald-400/60
        <% } else if(booking.status === 'pending'){ %>
            bg-amber-600/80 text-white border border-amber-400/60
        <% } else { %>
            bg-red-600/80 text-white border border-red-400/60
        <% } %>
    ">
        <%= booking.status.toUpperCase() %>
    </span>

</div>

        <div class="p-6 space-y-5">

            <h2 class="text-2xl font-bold text-white"><%= booking.home.houseName %></h2>

            <div class="text-gray-300 text-sm space-y-1">

                <div class="flex justify-between">
                    <span>Guest</span>
                    <span class="text-white font-semibold"><%= booking.user.name %></span>
                </div>

                <div class="flex justify-between">
                    <span>Check-in</span>
                    <span class="text-white font-semibold">
                        <%= new Date(booking.checkInDate).toDateString() %>
                    </span>
                </div>

                <div class="flex justify-between">
                    <span>Check-out</span>
                    <span class="text-white font-semibold">
                        <%= new Date(booking.checkOutDate).toDateString() %>
                    </span>
                </div>

                <div class="flex justify-between">
                    <span>Total Price</span>
                    <span class="text-lg font-bold text-white">₹ <%= booking.totalPrice %></span>
                </div>

            </div>


            <div class="border-t border-white/10 pt-4 space-y-6">

                <!-- OTP VERIFY -->
                <div>
                    <p class="text-white font-semibold mb-2">Verify using OTP</p>

                    <form action="/host/verify-otp/<%= booking._id %>" method="POST" class="flex gap-3 flex-col sm:flex-row">

                        <input name="otp"
                               placeholder="Enter OTP"
                               class="flex-1 px-4 py-2 rounded-xl bg-black/40 text-white border border-white/20">

                        <button class="px-6 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold">
                            Verify OTP
                        </button>

                    </form>
                </div>

                <!-- QR VERIFY -->
                <div>
                    <p class="text-white font-semibold mb-2">Verify using QR Code</p>

                    <button id="openScannerBtn"
                        class="w-full h-11 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold">
                        Open QR Scanner
                    </button>
                </div>

            </div>
        </div>
    </div>
</div>


<!-- QR SCANNER OVERLAY -->
<div id="scannerOverlay" class="hidden">
  <div id="reader"></div>
  <div class="qr-box"></div>
  <button onclick="closeScanner()" class="close-btn">Close</button>
</div>

<!-- SUCCESS FULL SCREEN -->
<div id="successFrame" class="success-frame"></div>

<!-- LOADER -->
<div id="loaderBox">
    <div class="loader"></div>
    <p class="text-center text-white mt-3">Verifying…</p>
</div>

<!-- TOAST HOLDER -->
<div id="toastContainer"></div>


<%- include('../partials/footer') %>

<script src="https://unpkg.com/html5-qrcode"></script>

<script>

let scanner = null;
let scanLocked = false;


/* ======================= */
/*        TOAST JS         */
/* ======================= */

function showToast(type, message){

    const div = document.createElement("div");
    div.className = `toast ${type}`;

    div.innerHTML = `
        <div class="toast-icon">
            ${ type === "success" ? "✔" : "⚠" }
        </div>

        <div>
            <p class="font-semibold">${ type === "success" ? "Success" : "Error" }</p>
            <p class="text-sm opacity-90">${message}</p>
        </div>
    `;

    document.body.appendChild(div);

    setTimeout(()=> div.classList.add("show"), 30);

    setTimeout(()=>{
        div.classList.remove("show");
        setTimeout(()=> div.remove(), 300);
    }, 4500);
}



/* ======================= */
/*      OPEN SCANNER       */
/* ======================= */

document.getElementById("openScannerBtn").addEventListener("click", async () => {

    scanLocked = false;

    document.getElementById("scannerOverlay").classList.remove("hidden");

    scanner = new Html5Qrcode("reader");

    try{
        await scanner.start(
            { facingMode: "environment" },
            {
                fps: 10,
                qrbox: function(viewportWidth){
                    if (viewportWidth > 800){
                        let size = viewportWidth * 0.35;
                        return { width: size, height: size };
                    }
                    let size = viewportWidth * 0.75;
                    return { width: size, height: size };
                }
            },
            onScanSuccess,
            ()=>{}
        );
    }catch(e){
        showToast("error","Camera not available or permission denied");
        closeScanner();
    }
});



/* ======================= */
/*      CLOSE SCANNER      */
/* ======================= */

async function closeScanner(){
    try{
        if(scanner){
            await scanner.stop();
            await scanner.clear();
        }
    }catch(e){}

    document.getElementById("scannerOverlay").classList.add("hidden");
}



/* ======================= */
/*     ON SCAN SUCCESS     */
/* ======================= */

async function onScanSuccess(decodedText){

    if(scanLocked) return;
    scanLocked = true;

    await closeScanner();

    document.getElementById("loaderBox").style.display = "flex";

    try{
        const res = await fetch("/host/verify-qr", {
            method: "POST",
            headers: { "Content-Type":"application/json" },
            body: JSON.stringify({
                data: decodedText,
                bookingId: "<%= booking._id %>"
            })
        });

        const json = await res.json();

        document.getElementById("loaderBox").style.display = "none";

        if(json.success){

            showToast("success","Guest verified successfully");
            document.getElementById("successFrame").style.display = "grid";

            setTimeout(()=>{
                window.location.href = "/host/bookingDetails/<%= booking._id %>";
            }, 4000);

        } else {
            showToast("error", json.message || "Verification failed");
        }

    }catch(e){
        document.getElementById("loaderBox").style.display = "none";
        showToast("error","Network error, try again");
    }
}
setTimeout(()=>{
  document.querySelectorAll('[data-otp-msg]').forEach(el => el.remove());
},4000);

</script>

</body>
</html>
