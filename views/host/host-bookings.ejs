<%- include('../partials/header') %>
</head>

<body class="bg-gradient-to-br from-gray-900 via-gray-800 to-black min-h-screen scroll-smooth">
<%- include('../partials/nav') %>

<div class="container mx-auto px-3 sm:px-4 py-6 sm:py-12 pt-28 sm:pt-32">

    <!-- PAGE HEADER -->
    <div class="text-center space-y-2 sm:space-y-4 mb-8 sm:mb-16">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-white/90">
            Home Bookings
        </h1>
        <p class="text-gray-400 max-w-2xl mx-auto text-xs sm:text-sm md:text-base">
            Review and manage bookings for all the homes you host.
        </p>
    </div>

    <% if(hostMsg){ %>
        <div id="hostMsg-alert" class="mb-6 max-w-2xl mx-auto">
            <div class="p-4 bg-emerald-50 border-l-4 border-emerald-500 rounded-r-md">
                <p class="text-sm text-gray-800 font-medium"><%= hostMsg %></p>
            </div>
        </div>
    <% } %>

    <% if(bookings && bookings.length > 0) { %>

    <div class="grid grid-cols-1 gap-4 sm:gap-6 md:gap-8 max-w-5xl mx-auto">

        <% bookings.forEach((b) => { %>

        <div class="booking-card">
            <div class="backdrop-blur-md bg-white/10 border border-white/20 rounded-xl sm:rounded-2xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-300">

                <!-- DESKTOP -->
                <div class="hidden sm:grid grid-cols-1 md:grid-cols-4 gap-0">

                    <!-- IMAGE -->
                    <div class="relative aspect-square overflow-hidden group">
                        <img src="<%= b.home.photoUrl %>"
                             alt="<%= b.home.houseName %>"
                             class="object-cover w-full h-full transform group-hover:scale-110 transition-transform duration-700">
                    </div>

                    <!-- INFO -->
                    <div class="md:col-span-2 p-4 sm:p-6 space-y-3 sm:space-y-4">

                        <div>
                            <h3 class="text-lg sm:text-xl font-bold text-white/90">
                                <%= b.home.houseName %>
                            </h3>
                            <p class="text-gray-400 text-xs sm:text-sm">
                                <%= b.home.location %>
                            </p>
                        </div>

                        <div class="space-y-2 sm:space-y-2">
                            <div class="flex justify-between text-xs sm:text-sm">
                                <span class="text-gray-400">Check-in:</span>
                                <span class="text-white/70 font-medium">
                                    <%= new Date(b.checkInDate).toDateString() %>
                                </span>
                            </div>

                            <div class="flex justify-between text-xs sm:text-sm">
                                <span class="text-gray-400">Check-out:</span>
                                <span class="text-white/70 font-medium">
                                    <%= new Date(b.checkOutDate).toDateString() %>
                                </span>
                            </div>

                            <div class="flex justify-between text-xs sm:text-sm">
                                <span class="text-gray-400">Guests:</span>
                                <span class="text-white/70 font-medium">
                                    <%= b.numberOfPeople %> People
                                </span>
                            </div>
                        </div>

                        <!-- GUEST INFO -->
                        <div class="mt-4 p-3 rounded-lg bg-white/5 border border-white/10">
                            <p class="text-gray-300 text-sm font-medium mb-1">Guest Details:</p>
                            <p class="text-gray-400 text-xs sm:text-sm">Name: <%= b.name %></p>
                            <p class="text-gray-400 text-xs sm:text-sm">Email: <%= b.email %></p>
                            <p class="text-gray-400 text-xs sm:text-sm">Phone: <%= b.countryCode %> <%= b.phoneNumber %></p>
                        </div>
                    </div>

                    <!-- STATUS + PRICE + ACTION -->
                    <div class="p-4 sm:p-6 flex flex-col justify-between items-end border-l border-white/10">

                        <!-- STATUS -->
                        <div>
                            <% if(b.status === "Confirmed"){ %>
                                <span class="inline-block px-4 py-2 rounded-full text-sm font-semibold backdrop-blur-md bg-emerald-600/30 border border-emerald-500/50 text-emerald-300">
                                    ✓ Confirmed
                                </span>
                            <% } else if(b.status === "Cancelled"){ %>
                                <span class="inline-block px-4 py-2 rounded-full text-sm font-semibold backdrop-blur-md bg-red-600/30 border border-red-500/50 text-red-300">
                                    ✗ Cancelled
                                </span>
                            <% } else if(b.status === "checkedIn"){ %>
                                <span class="inline-block px-4 py-2 rounded-full text-sm font-semibold backdrop-blur-md bg-blue-600/30 border border-blue-500/50 text-blue-300">
                                    checkedIn
                                </span>
                            <% } else { %>
                                <span class="inline-block px-4 py-2 rounded-full text-sm font-semibold backdrop-blur-md bg-yellow-600/30 border border-yellow-500/50 text-yellow-300">
                                    ⏳ Pending
                                </span>
                            <% } %>
                        </div>

                        <!-- PRICE -->
                        <div class="text-right mt-4">
                            <p class="text-xs sm:text-sm text-gray-400">Total Amount</p>
                            <p class="text-lg sm:text-xl md:text-2xl font-bold text-emerald-400">
                                ₹<%= b.totalPrice %>
                            </p>
                        </div>

                        <!-- ACTION BUTTONS -->
                        <div class="flex flex-col gap-2 mt-5 w-full">

                            <% if(b.status === 'Pending'){ %>
                                <button
                                    onclick="openConfirmModal('<%= b._id %>')"
                                    class="w-full px-4 py-2 rounded-md bg-emerald-600/70 
                                           hover:bg-emerald-600 text-white text-xs sm:text-sm 
                                           transition font-medium">
                                    Confirm
                                </button>

                                <% if(b.cancellable){ %>
                                <button
                                    onclick="openCancelModal('<%= b._id %>')"
                                    class="w-full px-4 py-2 rounded-md bg-red-600/70 
                                           hover:bg-red-600 text-white text-xs sm:text-sm 
                                           transition font-medium">
                                    Cancel
                                </button>
                                <% } %>
                            <% } %>

                            <% if(b.status === 'Confirmed' || b.status === 'checkedIn'){ %>
                            <a href="/host/bookingDetails/<%= b._id %>">
                                <button class="w-full px-4 py-2 rounded-md bg-blue-600/70 
                                               hover:bg-blue-600 text-white text-xs sm:text-sm 
                                               transition font-medium">
                                    <%= b.status === 'Confirmed' ? 'Verify guest' : 'See more' %>
                                </button>
                            </a>
                            <% } %>

                        </div>

                    </div>
                </div>

                <!-- MOBILE -->
                <div class="sm:hidden">

                    <!-- IMAGE -->
                    <div class="relative aspect-video overflow-hidden group">
                        <img src="<%= b.home.photoUrl %>"
                             alt="<%= b.home.houseName %>"
                             class="object-cover w-full h-full transform group-hover:scale-110 transition-transform duration-700">

                        <div class="absolute top-2 right-2">
                            <% if(b.status === "Confirmed"){ %>
                                <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold backdrop-blur-md bg-emerald-600/30 border border-emerald-500/50 text-emerald-300">
                                    ✓ Confirmed
                                </span>
                            <% } else if(b.status === "Cancelled"){ %>
                                <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold backdrop-blur-md bg-red-600/30 border border-red-500/50 text-red-300">
                                    ✗ Cancelled
                                </span>
                            <% } else { %>
                                <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold backdrop-blur-md bg-yellow-600/30 border border-yellow-500/50 text-yellow-300">
                                    ⏳ Pending
                                </span>
                            <% } %>
                        </div>
                    </div>

                    <div class="p-4 space-y-3">

                        <h3 class="text-base font-bold text-white/90"><%= b.home.houseName %></h3>
                        <p class="text-gray-400 text-xs"><%= b.home.location %></p>

                        <div class="space-y-1.5 text-xs border-y border-white/10 py-3">
                            <div class="flex justify-between">
                                <span class="text-gray-400">Check-in:</span>
                                <span class="text-white/70"><%= new Date(b.checkInDate).toLocaleDateString() %></span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-400">Check-out:</span>
                                <span class="text-white/70"><%= new Date(b.checkOutDate).toLocaleDateString() %></span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-gray-400">Guests:</span>
                                <span class="text-white/70"><%= b.numberOfPeople %></span>
                            </div>
                        </div>

                        <div class="flex justify-between items-center">
                            <p class="text-gray-400 text-xs">Total</p>
                            <p class="text-xl font-bold text-emerald-400">₹<%= b.totalPrice %></p>
                        </div>

                        <% if(b.status === 'Pending'){ %>
                        <div class="flex gap-3 pt-2">
                            <button
                                onclick="openConfirmModal('<%= b._id %>')"
                                class="w-1/2 py-2 rounded-lg bg-emerald-600/70 hover:bg-emerald-600 text-white text-xs font-medium">
                                Confirm
                            </button>

                            <% if(b.cancellable){ %>
                            <button
                                onclick="openCancelModal('<%= b._id %>')"
                                class="w-1/2 py-2 rounded-lg bg-red-600/70 hover:bg-red-600 text-white text-xs font-medium">
                                Cancel
                            </button>
                            <% } %>
                        </div>
                        <% } %>

                        <% if(b.status === 'Confirmed' || b.status === 'checkedIn'){ %>
                        <a href="/host/bookingDetails/<%= b._id %>">
                            <button class="w-full py-2 rounded-lg bg-blue-600/70 hover:bg-blue-600 text-white text-xs font-medium">
                                <%= b.status === 'Confirmed' ? 'Verify guest' : 'See more' %>
                            </button>
                        </a>
                        <% } %>

                    </div>
                </div>

            </div>
        </div>

        <% }) %>
    </div>

    <% } %>

</div>

<!-- CONFIRMATION MODAL -->
<div id="actionModal" class="fixed inset-0 hidden z-50 bg-black/60 flex items-center justify-center">
    <div class="bg-gray-900 rounded-xl p-6 max-w-sm w-full border border-white/20">
        <h3 id="modalTitle" class="text-lg font-semibold text-white"></h3>
        <p id="modalText" class="text-sm text-gray-400 mt-2"></p>

        <form id="actionForm" method="POST" class="mt-5 flex justify-end gap-3">
            <button type="button"
                    onclick="closeActionModal()"
                    class="px-4 py-2 rounded-md bg-white/10 hover:bg-white/20 text-white text-sm">
                Go Back
            </button>
            <button id="modalBtn"
                    type="submit"
                    class="px-4 py-2 rounded-md text-white text-sm font-medium">
                Confirm
            </button>
        </form>
    </div>
</div>

<script>
/* auto-hide success msg */
const alertBox = document.getElementById("hostMsg-alert");
if (alertBox) {
    setTimeout(() => {
        alertBox.style.opacity = "0";
        setTimeout(() => alertBox.remove(), 600);
    }, 5000);
}

/* modal logic */
const modal = document.getElementById("actionModal");
const form = document.getElementById("actionForm");
const title = document.getElementById("modalTitle");
const text = document.getElementById("modalText");
const btn = document.getElementById("modalBtn");

function openConfirmModal(id){
    title.textContent = "Confirm Booking";
    text.textContent = "Are you sure you want to confirm this booking?";
    btn.textContent = "Yes, Confirm";
    btn.className = "px-4 py-2 rounded-md bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium";
    form.action = `/host/booking/${id}/confirm`;
    modal.classList.remove("hidden");
}

function openCancelModal(id){
    title.textContent = "Cancel Booking";
    text.textContent = "Are you sure you want to cancel this booking?";
    btn.textContent = "Yes, Cancel";
    btn.className = "px-4 py-2 rounded-md bg-red-600 hover:bg-red-700 text-white text-sm font-medium";
    form.action = `/host/booking/${id}/cancel`;
    modal.classList.remove("hidden");
}

function closeActionModal(){
    modal.classList.add("hidden");
}
</script>

<%- include('../partials/footer') %>
</body>
</html>
