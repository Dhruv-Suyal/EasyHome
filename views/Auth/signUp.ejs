<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SignUp page</title>
    <link rel="stylesheet" href="output.css">
</head>
<body class="bg-gradient-to-br from-gray-900 via-gray-800 to-black min-h-screen flex items-center justify-center">
  <div class="max-w-md w-full">
    <div class="backdrop-blur-md bg-white/10 border border-white/20 rounded-2xl shadow-xl p-8 space-y-6">
      <div class="text-center">
        <h1 class="text-3xl font-bold text-white/90">Create Account</h1>
        <p class="text-gray-400 text-sm mt-2">Join us and start your journey</p>
      </div>

      <%- include('../partials/errors') %>

      <form action="/signUp" method="POST" class="space-y-4">
        <div class="space-y-2">
          <label class="block text-sm font-medium text-white/70">Full Name</label>
          <input name="name" type="text" value="<%= oldInput.name %>" required
            class="w-full px-4 py-3 rounded-lg backdrop-blur-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all duration-300"
            placeholder="Jane Doe"/>
        </div>

        <div class="space-y-2">
          <label class="block text-sm font-medium text-white/70">Email Address</label>
          <input name="email" type="email" value="<%= oldInput.email %>" required
            class="w-full px-4 py-3 rounded-lg backdrop-blur-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all duration-300"
            placeholder="you@example.com" />
        </div>

        <div class="space-y-2">
          <label class="block text-sm font-medium text-white/70">Password</label>
          <input name="password" type="password" minlength="8" required
            class="w-full px-4 py-3 rounded-lg backdrop-blur-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all duration-300"
            placeholder="At least 8 characters" />
        </div>

        <div class="space-y-2">
          <label class="block text-sm font-medium text-white/70">Confirm Password</label>
          <input name="confirmPassword" type="password" minlength="8" required
            class="w-full px-4 py-3 rounded-lg backdrop-blur-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all duration-300"
            placeholder="Repeat your password" />
        </div>

        <div class="space-y-2">
          <p class="text-sm font-medium text-white/70">Select User Type</p>
          <div class="flex gap-4">
            <label class="flex items-center gap-2 cursor-pointer">
              <input name="userType" type="radio" value="guest" <%= oldInput.userType === 'guest' ? 'checked' : '' %>
                class="w-4 h-4"/>
              <span class="text-sm text-white/70">Guest</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input name="userType" type="radio" value="host" <%= oldInput.userType === 'host' ? 'checked' : '' %>
                class="w-4 h-4"/>
              <span class="text-sm text-white/70">Host</span>
            </label>
          </div>
        </div>

        <button type="submit"
          class="w-full mt-6 px-6 py-3 rounded-lg text-white font-medium backdrop-blur-lg bg-blue-600/80 border border-blue-500/30 shadow-lg transition-all duration-300 hover:scale-105 hover:bg-blue-600">
          Sign Up
        </button>
      </form>

      <div class="text-center pt-4 border-t border-white/10">
        <p class="text-sm text-gray-400">Already have an account? <a href="/login" class="text-blue-400 hover:underline font-medium">Log in</a></p>
      </div>

      <p class="text-xs text-gray-500 text-center">
        By signing up you agree to our <a href="#" class="text-blue-400 hover:underline">Terms</a> and <a href="#" class="text-blue-400 hover:underline">Privacy Policy</a>
      </p>
    </div>
  </div>
</body>
</html>